function %sibling_loops(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    jump block1(v0)

block1(v2: i64):
    jump block2(v2)

block2(v3: i64):
    v8 = iconst.i64 -1
    v4 = iadd v3, v8
    brif v4, block2(v4), block3

block3:
    jump block4(v2)

block4(v5: i64):
    ;; The shift can move to block3. Moving it to block1 would cross the first
    ;; inner loop, which has already exited and does not contain block4.
    v6 = ushr v2, v1
    v7 = isub v5, v6
    brif v7, block4(v7), block5

block5:
    brif v1, block1(v7), block6

block6:
    return v7
}

