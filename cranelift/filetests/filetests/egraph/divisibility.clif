function %folded_divisor(i32) -> i8 {
block0(v0: i32):
    v1 = iconst.i32 3
    v2 = iconst.i32 4
    v3 = iadd v1, v2
    v4 = srem v0, v3
    v5 = iconst.i32 0
    v6 = icmp eq v4, v5
    return v6
}

