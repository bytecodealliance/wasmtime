function %s32_multiple_of_min(i32) -> i8 {
block0(v0: i32):
    v1 = iconst.i32 0x80000000
    v2 = srem v0, v1
    v3 = iconst.i32 0
    v4 = icmp eq v2, v3
    return v4
}

