function %s8_multiple_of_7(i8) -> i8, i8, i8, i8 {
block0(v0: i8):
    v1 = iconst.i8 7
    v2 = srem v0, v1
    v3 = iconst.i8 0
    v4 = icmp eq v2, v3
    v5 = icmp ne v2, v3
    v6 = icmp eq v3, v2
    v7 = icmp ne v3, v2
    return v4, v5, v6, v7
}

