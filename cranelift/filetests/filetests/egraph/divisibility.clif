function %remainder_also_returned(i32) -> i32, i8 {
block0(v0: i32):
    v1 = iconst.i32 7
    v2 = srem v0, v1
    v3 = iconst.i32 0
    v4 = icmp eq v2, v3
    return v2, v4
}

