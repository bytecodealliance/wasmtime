;; A power-of-two divisor is already a mask and a test.

function %u32_multiple_of_8_eq(i32) -> i8 {
block0(v0: i32):
    v1 = iconst.i32 8
    v2 = urem v0, v1
    v3 = iconst.i32 0
    v4 = icmp eq v2, v3
    return v4
}

; function %u32_multiple_of_8_eq(i32) -> i8 fast {
; block0(v0: i32):
;     v5 = iconst.i32 7
;     v6 = band v0, v5  ; v5 = 7
;     v2 -> v6
;     v3 = iconst.i32 0
;     v4 = icmp eq v6, v3  ; v3 = 0
;     return v4
; }

;; Only equality and inequality test divisibility; the ordering predicates must
;; be left alone (and must not reach the div-const helpers).

function %u32_multiple_of_7_slt(i32) -> i8 {
block0(v0: i32):
    v1 = iconst.i32 7
    v2 = urem v0, v1
    v3 = iconst.i32 0
    v4 = icmp slt v2, v3
    return v4
}

