function %s64_multiple_of_7_sge(i64) -> i8 {
block0(v0: i64):
    v1 = iconst.i64 7
    v2 = srem v0, v1
    v3 = iconst.i64 0
    v4 = icmp sge v2, v3
    return v4
}

