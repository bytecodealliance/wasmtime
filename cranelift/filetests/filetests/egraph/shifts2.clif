test optimize precise-output
set opt_level=speed
target x86_64

function %fold_shifts_over_and1(i32, i32, i32) -> i32 {
block0(v0: i32, v1: i32, v3: i32):
    v2 = ishl v0, v1
    v4 = band v2, v3
    v5 = ushr v4, v1
    return v5
}

