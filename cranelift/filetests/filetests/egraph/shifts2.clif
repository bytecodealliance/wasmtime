; }

function %fold_shifts_over_and2(i64, i64, i64) -> i64 {
block0(v0: i64, v1: i64, v3: i64):
    v2 = ishl v0, v1
    v4 = band v2, v3
    v5 = ushr v4, v1
    return v5
}

