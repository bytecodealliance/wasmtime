function %negate_lt(i8, i8) -> i8 fast {
block0(v0: i8, v1: i8):
    v2 = icmp ult v0, v1
    v3 = iconst.i8 1
    v4 = icmp ne v2, v3
    return v4
}

; function %negate_lt(i8, i8) -> i8 fast {
