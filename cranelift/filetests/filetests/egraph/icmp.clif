;     v5 = icmp uge v0, v1
;     return v5
; }

;; `x == (x ^ y)` to `y == 0`.
function %simplify_icmp_eq_x_bxor_x_y(i32, i32) -> i8 fast {
block0(v0: i32, v1: i32):
    v2 = bxor v0, v1
    v3 = icmp eq v0, v2
    return v3
}

; function %simplify_icmp_eq_x_bxor_x_y(i32, i32) -> i8 fast {
; block0(v0: i32, v1: i32):
;     v4 = iconst.i32 0
;     v5 = icmp eq v1, v4  ; v4 = 0
;     return v5
; }


;; `x != (x ^ y)` to `y != 0`.
function %simplify_icmp_ne_x_bxor_x_y(i32, i32) -> i8 fast {
block0(v0: i32, v1: i32):
    v2 = bxor v0, v1
    v3 = icmp ne v0, v2
    return v3
}

; function %simplify_icmp_ne_x_bxor_x_y(i32, i32) -> i8 fast {
; block0(v0: i32, v1: i32):
;     v4 = iconst.i32 0
;     v5 = icmp ne v1, v4  ; v4 = 0
;     return v5
; }

;; `~x == x` to false.
function %simplify_icmp_eq_bnot_x_x(i32) -> i8 fast {
block0(v0: i32):
    v1 = bnot v0
    v2 = icmp eq v1, v0
    return v2
}

; function %simplify_icmp_eq_bnot_x_x(i32) -> i8 fast {
; block0(v0: i32):
;     v3 = iconst.i8 0
;     return v3  ; v3 = 0
; }

;; `~x != x` to true.
function %simplify_icmp_ne_bnot_x_x(i32) -> i8 fast {
block0(v0: i32):
    v1 = bnot v0
    v2 = icmp ne v1, v0
    return v2
}

; function %simplify_icmp_ne_bnot_x_x(i32) -> i8 fast {
; block0(v0: i32):
;     v3 = iconst.i8 1
;     return v3  ; v3 = 1
; }

function %issue_10929_no_crash_on_icmp_vectors() -> i32x4 {
  const0 = 0x40ad3fb47cb16076c8cb1fdd8189d40f

block0():
  v1 = vconst.i32x4 const0
  v4 = bnot v1
  v2 = bxor v1, v4
  v3 = icmp.i32x4 ne v1, v2
  return v3
}

; function %issue_10929_no_crash_on_icmp_vectors() -> i32x4 fast {
