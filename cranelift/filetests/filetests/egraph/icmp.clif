;; (ne cty (select ty (slt cty x y) x y) x) -> (sgt cty x y)
function %simplify_select_slt_ne_i32(i32, i32) -> i8 fast {
block0(v0: i32, v1: i32):
    v2 = icmp slt v0, v1
    v3 = select v2, v0, v1
    v4 = icmp ne v3, v0
    return v4
}

