;; select(c, ~x, ~y) --> ~select(c, x, y)
function %select_bnot_bnot(i32, i32, i32, i32) -> i32 {
block0(v0: i32, v1: i32, v2: i32, v3: i32):
    v4 = icmp.i8 eq v0, v1
    v5 = bnot.i32 v2
    v6 = bnot.i32 v3
    v7 = select.i32 v4, v5, v6
    return v7
}

