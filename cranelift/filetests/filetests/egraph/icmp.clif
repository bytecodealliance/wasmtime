;     v4 = icmp eq v0, v1
;     v8 = select v4, v2, v3
;     v9 = bnot v8
;     return v9
; }

;; select(c, -x, -y) --> -select(c, x, y)
function %select_ineg_ineg(i32, i32, i32, i32) -> i32 {
block0(v0: i32, v1: i32, v2: i32, v3: i32):
    v4 = icmp eq v0, v1
    v5 = ineg v2
    v6 = ineg v3
    v7 = select v4, v5, v6
    return v7
}

