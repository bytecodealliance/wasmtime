; Rules that build `iconst_u`/`iconst_s` should not fire on a 64-bit vector type.
test optimize precise-output
set opt_level=speed
target x86_64

;; `(~x) + x --> -1` should not build `iconst_s` on 64-bit vector type.
function %bnot_iadd_i32x2(i32x2) -> i32x2 {
block0(v0: i32x2):
    v1 = bnot v0
    v2 = iadd v1, v0
    return v2
}

; function %bnot_iadd_i32x2(i32x2) -> i32x2 fast {
; block0(v0: i32x2):
;     v1 = bnot v0
;     v2 = iadd v1, v0
;     return v2
; }

;; `x + (~x) --> -1` should not build `iconst_s` on 64-bit vector type.
function %iadd_bnot_i32x2(i32x2) -> i32x2 {
block0(v0: i32x2):
    v1 = bnot v0
    v2 = iadd v0, v1
    return v2
}

; function %iadd_bnot_i32x2(i32x2) -> i32x2 fast {
; block0(v0: i32x2):
;     v1 = bnot v0
;     v2 = iadd v0, v1
;     return v2
; }

;; `-(~x) --> x + 1` should not build `iconst_u` on 64-bit vector type.
function %ineg_bnot_i32x2(i32x2) -> i32x2 {
block0(v0: i32x2):
    v1 = bnot v0
    v2 = ineg v1
    return v2
}

; function %ineg_bnot_i32x2(i32x2) -> i32x2 fast {
; block0(v0: i32x2):
;     v1 = bnot v0
;     v2 = ineg v1
;     return v2
; }

;; `~(-x) --> x - 1` should not build `iconst_u` on 64-bit vector type.
function %bnot_ineg_i32x2(i32x2) -> i32x2 {
block0(v0: i32x2):
    v1 = ineg v0
    v2 = bnot v1
    return v2
}

