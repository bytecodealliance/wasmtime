test optimize precise-output
set opt_level=speed
target x86_64

;; The constant is first elaborated in one arm of the branch. In the other
;; arm, it is cloned and hoisted out of the loop. Both the pure select and
;; the side-effecting store must rematerialize the clone inside the loop.
function %constant(i64, i64, i64) -> i64 {
block0(v0: i64, v1: i64, v2: i64):
    v3 = iconst.i64 0x7ff9_0000_0000_0000
    brif v0, block2, block1

block1:
    return v3

block2:
    jump block3(v1)

block3(v4: i64):
    v5 = select v4, v3, v4
    store v5, v2
    store v3, v2+8
    brif v4, block3(v5), block4

block4:
    return v4
}

