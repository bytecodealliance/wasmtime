; block4:
;     return v4
; }

;; Cloning must also preserve rematerialization for non-constant instructions,
;; even without loops. The clone in block2 should be rematerialized in block3.
function %bnot(i64, i64, i64) -> i64 {
block0(v0: i64, v1: i64, v2: i64):
    v3 = bnot v1
    brif v0, block2, block1

block1:
    return v3

block2:
    store v3, v2
    jump block3

block3:
    return v3
}

