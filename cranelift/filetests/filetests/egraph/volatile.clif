test optimize precise-output
set opt_level=speed
target x86_64

;; A volatile load is a side effect: it is neither merged with an identical
;; load in a dominated block (GVN) nor hoisted out of a loop (LICM).

function %volatile_no_gvn(i64, i8) -> i32 {
block0(v0: i64, v1: i8):
    v2 = load.i32 notrap aligned volatile v0
    brif v1, block1, block2

block1:
    v3 = load.i32 notrap aligned volatile v0
    v4 = iadd v2, v3
    return v4

block2:
    return v2
}

