;; Readonly, notrap and can_move loads are pure and merged; the same load
;; with `volatile` (and without the flags `volatile` forbids) is not.
function %pure_vs_volatile(i64) -> i32 {
block0(v0: i64):
    v1 = load.i32 notrap aligned readonly can_move v0
    v2 = load.i32 notrap aligned readonly can_move v0
    v3 = load.i32 notrap aligned volatile v0
    v4 = load.i32 notrap aligned volatile v0
    v5 = iadd v1, v2
    v6 = iadd v3, v4
    v7 = iadd v5, v6
    return v7
}

