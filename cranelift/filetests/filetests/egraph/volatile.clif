function %volatile_no_licm(i64, i32) -> i32 {
block0(v0: i64, v1: i32):
    v2 = iconst.i32 0
    jump block1(v2, v2)

block1(v3: i32, v4: i32):
    v5 = load.i32 notrap aligned volatile v0
    v6 = iadd v4, v5
    v9 = iconst.i32 1
    v7 = iadd v3, v9
    v8 = icmp ult v7, v1
    brif v8, block1(v7, v6), block2

block2:
    return v6
}

