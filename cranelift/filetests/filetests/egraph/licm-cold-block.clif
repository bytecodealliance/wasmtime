;; A cold loop header: `v4` is loop invariant but is not hoisted into the
;; preheader.
function %cold_loop_header(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    v2 = iconst.i64 0
    jump block1(v2)

block1(v3: i64) cold:
    v4 = imul v0, v1
    v5 = iadd v3, v4
    v6 = icmp ult v5, v1
    brif v6, block1(v5), block2

block2:
    return v5
}

