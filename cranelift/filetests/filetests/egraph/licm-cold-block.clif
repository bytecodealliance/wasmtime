test optimize precise-output
set opt_level=speed
target x86_64

;; Loop-invariant values in a cold block inside a loop are not hoisted out of
;; the cold block, because that would move cold-path work into the loop
;; preheader.
function %cold_block_in_loop(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    v2 = iconst.i64 0
    jump block1(v2)

block1(v3: i64):
    v4 = icmp ult v3, v1
    brif v4, block2, block3(v3)

block2 cold:
    ;; All of these except `v9` are loop invariant, but must stay here.
    v5 = load.i64 notrap aligned readonly can_move v0+8
    v6 = load.i64 notrap aligned readonly can_move v5+16
    v7 = imul v0, v1
    v8 = iadd v6, v7
    v9 = iadd v3, v8
    jump block3(v9)

block3(v10: i64):
    v11 = iconst.i64 1
    v12 = iadd v10, v11
    v13 = icmp ult v12, v1
    brif v13, block1(v12), block4

block4:
    return v12
}

