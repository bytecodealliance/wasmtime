;; Argument-less values like `vconst`, which are normally hoisted out of one
;; loop level, are not hoisted out of cold blocks either.
function %cold_block_vconst(i64, i64x2) -> i64x2 {
block0(v0: i64, v1: i64x2):
    v2 = iconst.i64 0
    jump block1(v2, v1)

block1(v3: i64, v4: i64x2):
    v5 = icmp ult v3, v0
    brif v5, block2, block3(v4)

block2 cold:
    v6 = vconst.i64x2 [1 2]
    v7 = iadd v4, v6
    jump block3(v7)

block3(v8: i64x2):
    v9 = iconst.i64 1
    v10 = iadd v3, v9
    v11 = icmp ult v10, v0
    brif v11, block1(v10, v8), block4

block4:
    return v8
}

