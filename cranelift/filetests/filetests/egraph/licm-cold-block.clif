;; A cold block in an inner loop: `v6` is invariant in both loops but is
;; hoisted out of neither.
function %cold_block_in_nested_loop(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    v2 = iconst.i64 0
    jump block1(v2)

block1(v3: i64):
    jump block2(v3)

block2(v4: i64):
    v5 = icmp ult v4, v1
    brif v5, block3, block4(v4)

block3 cold:
    v6 = imul v0, v1
    v7 = iadd v4, v6
    jump block4(v7)

block4(v8: i64):
    v9 = iconst.i64 1
    v10 = iadd v8, v9
    v11 = icmp ult v10, v0
    brif v11, block2(v10), block5

block5:
    v12 = icmp ult v10, v1
    brif v12, block1(v10), block6

block6:
    return v10
}

