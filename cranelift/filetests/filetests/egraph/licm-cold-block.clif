;; When a hot block that dominates a cold block uses the same loop-invariant
;; value (`v4`/`v7`), the value is hoisted for the hot use and the cold block
;; reuses it.
function %cold_block_reuses_hoisted_value(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    v2 = iconst.i64 0
    jump block1(v2)

block1(v3: i64):
    v4 = imul v0, v1
    v5 = iadd v3, v4
    v6 = icmp ult v5, v1
    brif v6, block2, block3(v5)

block2 cold:
    v7 = imul v0, v1
    v8 = isub v3, v7
    jump block3(v8)

block3(v9: i64):
    v10 = iconst.i64 1
    v11 = iadd v9, v10
    v12 = icmp ult v11, v1
    brif v12, block1(v11), block4

block4:
    return v11
}

