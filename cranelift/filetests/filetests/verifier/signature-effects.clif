test verifier

function %ok(i64) notrap nothrow reads(region0) writes(region0) {
    region0 = 0 "A"
    sig0 = (i64) notrap nothrow reads(region0) writes(none)
block0(v0: i64):
    v1 = load.i64 notrap region0 v0
    store notrap region0 v1, v0
    call_indirect sig0, v0(v0)
    return
}

;; A trap reads only the regions the signature declares.
function %trap_ok(i64) reads(region0) writes(none) {
    region0 = 0 "A"
block0(v0: i64):
    v1 = load.i64 region0 v0
    trapz v1, user1
    return
}

;; A trapping store reads only the other regions the signature declares.
function %trapping_store_ok(i64) reads(none) writes(region0) {
    region0 = 0 "A"
block0(v0: i64):
    store region0 v0, v0
    return
}

function %reads(i64) reads(none) {
    region0 = 0 "A"
block0(v0: i64):
    v1 = load.i64 notrap region0 v0 ; error: instruction reads region0, which is not in the function signature's `reads` set
    return
}

