test verifier

;; The handler must be tail-callable with the function's own arguments.

function %ok(i64 vmctx, i64) tail {
    gv0 = vmctx
    stack_limit = gv0, handler = fn0
    fn0 = colocated %h(i64 vmctx) tail
block0(v0: i64, v1: i64):
    return
}

function %not_colocated(i64 vmctx) tail {
    gv0 = vmctx
    stack_limit = gv0, handler = fn0 ; error: stack-limit handler fn0 must be `colocated`
    fn0 = %h(i64 vmctx) tail
block0(v0: i64):
    return
}

function %wrong_call_conv(i64 vmctx) tail {
    gv0 = vmctx
    stack_limit = gv0, handler = fn0 ; error: must use the function's calling convention `tail`, not `system_v`
