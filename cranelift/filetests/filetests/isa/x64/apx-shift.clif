; block1: ; offset 0x4
;   movq %rsi, %rcx
;   .byte 0x62, 0xf4, 0xfc, 0x18, 0xd3, 0xc7, 0x48, 0x89
;   .byte 0xec, 0x5d, 0xc3

function %rotr_var_i32(i32, i32) -> i32 {
block0(v0: i32, v1: i32):
    v2 = rotr v0, v1
    return v2
}

