;   pushq %rbp
;   movq %rsp, %rbp
; block1: ; offset 0x4
;   .byte 0x62, 0xf4, 0xfc, 0x18, 0xc1, 0xe7, 0x01, 0x48
;   .byte 0x89, 0xec, 0x5d, 0xc3

function %rotl_var_i64(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    v2 = rotl v0, v1
    return v2
}

