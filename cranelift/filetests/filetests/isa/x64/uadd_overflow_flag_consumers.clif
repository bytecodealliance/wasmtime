;   movq %rbp, %rsp
;   popq %rbp
;   retq
;
; Disassembled:
; block0: ; offset 0x0
;   pushq %rbp
;   movq %rsp, %rbp
; block1: ; offset 0x4
;   addq %rsi, %rdi
;   jae 0x16
;   leaq (%rdi, %rdx), %rax
;   movq %rbp, %rsp
;   popq %rbp
;   retq
;   ud2 ; trap: user1

