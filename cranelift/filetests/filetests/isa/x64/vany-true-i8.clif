test compile precise-output
set unwind_info=false
target x86_64 has_sse3 has_ssse3 has_sse41

function %vany_true_i8(i8) -> i8 {
block0(v0: i8):
    v1 = scalar_to_vector.i8x16 v0
    v2 = vany_true v1
    return v2
}

