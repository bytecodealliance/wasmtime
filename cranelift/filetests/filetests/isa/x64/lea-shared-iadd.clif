test compile
target x86_64

function %shared_i32(i32, i32) -> i32, i32 {
block0(v0: i32, v1: i32):
    v2 = iadd v0, v1
    v3 = iconst.i32 100
    v4 = iadd v2, v3
    return v2, v4
}

; check: leal (%rdi, %rsi), %eax
; check: leal 0x64(%rax), %edx

function %shared_i32_loop(i32, i32, i8) -> i32 {
block0(v0: i32, v1: i32, v2: i8):
    jump block1(v0)
block1(v3: i32):
    v4 = iadd v3, v1
    brif v2, block1(v4), block2
block2:
    v5 = iconst.i32 100
    v6 = iadd v4, v5
    return v6
}

; check: leal 0x64(%rdi), %eax

function %shared_i64_address(i64, i64) -> i32, i32 {
block0(v0: i64, v1: i64):
    v2 = iadd v0, v1
    v3 = load.i32 notrap v2
    v4 = iconst.i64 4
    v5 = iadd v2, v4
    v6 = load.i32 notrap v5
    return v3, v6
}

; check: movl (%rdi, %rsi), %eax
; check: movl 4(%rdi, %rsi), %edx
