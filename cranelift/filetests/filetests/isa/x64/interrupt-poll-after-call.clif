;   pushq %rbp
;   movq %rsp, %rbp
;   subq $0x10, %rsp
; block1: ; offset 0x8
;   movq 0x20(%rbp), %r11
;   movq %rdi, (%rsp)
;   movabsq $0, %r8 ; reloc_external Abs8 %g 0
;   callq *%r8
;   nop
;   movq (%r11), %r10 ; trap: user3
;   movq %r11, %rax
;   addq $0x10, %rsp
;   movq %rbp, %rsp
