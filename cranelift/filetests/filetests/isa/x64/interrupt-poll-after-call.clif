;   movq %rsp, %rbp
;   subq $0x10, %rsp
; block0:
;   movq <offset:0>+-0x10(%rbp), %r11
;   movq %rdi, <offset:1>+(%rsp)
;   load_ext_name %g+0, %r8
;   call    *%r8
;   ; UserStackMap { by_type: [(types::I64, CompoundBitSet {0})], sp_to_sized_stack_slots: None }
;   %r11 = interrupt_poll load_ptr=%r11, context=%rdi, scratch=%r10 #trap=user3
;   ; UserStackMap { by_type: [(types::I64, CompoundBitSet {0})], sp_to_sized_stack_slots: None }
;   movq %r11, %rax
;   addq $0x10, %rsp
;   movq %rbp, %rsp
;   popq %rbp
;   retq $0x20
;
