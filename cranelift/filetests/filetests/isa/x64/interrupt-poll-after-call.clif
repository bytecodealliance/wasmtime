test compile precise-output
target x86_64

;; A call's stack map is associated with its return PC, while an
;; `interrupt_poll`'s stack map is associated with the faulting load's PC. A
;; `preserve_all` call preserves every register, so a following poll can use
;; incoming registers without any operand setup and the two PCs coincide. The
;; emitter separates them with a nop so that exact-PC stack map lookups remain
;; unambiguous.

function %f(i64, i64, i64, i64, i64, i64, i64, i64, i64) -> i64 tail {
    ss0 = explicit_slot 8, align = 8
    sig0 = () preserve_all
    fn0 = %g sig0
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64, v6: i64, v7: i64, v8: i64):
    v9 = stack_addr.i64 ss0
    store notrap v0, v9
    call fn0(), stack_map=[i64 @ ss0+0]
    v10 = interrupt_poll v8, v0, user3, stack_map=[i64 @ ss0+0]
    return v10
}

; VCode:
