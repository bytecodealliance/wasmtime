test compile precise-output
set opt_level=speed
target x86_64

function %umul_flags_trapz(i64, i64, i64) -> i64 {
block0(v0: i64, v1: i64, v2: i64):
  v3, v4 = umul_overflow v0, v1
  trapz v4, user1
  v5 = iadd v3, v2
  return v5
}

