;; A small frame: the frame size (plus this function's own setup area) is added
;; to the limit before comparing.
function %handler_small_frame(i64 vmctx) tail {
    ss0 = explicit_slot 168
    gv0 = vmctx
    gv1 = load.i64 notrap aligned gv0
    gv2 = load.i64 notrap aligned gv1+8
    stack_limit = gv2, handler = fn0
    fn0 = colocated %overflow(i64 vmctx) tail
block0(v0: i64):
    return
}

