test compile precise-output
target x86_64

;; A volatile load may be folded into its user's memory operand like any
;; other singly-used load: it is still performed once, with its own width.
function %volatile_add(i64, i32) -> i32 {
block0(v0: i64, v1: i32):
    v2 = load.i32 notrap volatile v0
    v3 = iadd.i32 v2, v1
    return v3
}

; VCode:
;   pushq %rbp
;   movq %rsp, %rbp
; block0:
;   movq %rsi, %rax
;   addl (%rdi), %eax
;   movq %rbp, %rsp
;   popq %rbp
;   retq
;
; Disassembled:
; block0: ; offset 0x0
;   pushq %rbp
;   movq %rsp, %rbp
; block1: ; offset 0x4
;   movq %rsi, %rax
;   addl (%rdi), %eax
;   movq %rbp, %rsp
;   popq %rbp
;   retq

;; A volatile load is emitted even when its value is unused.
function %volatile_load_unused(i64) {
block0(v0: i64):
    v1 = load.i64 notrap volatile v0
    v2 = load.i8 notrap volatile v0
    return
}

