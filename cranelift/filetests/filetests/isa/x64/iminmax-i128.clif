test compile
set enable_llvm_abi_extensions
set opt_level=speed_and_size
target x86_64

;; Mid-end rewrites `select(ugt, a, b)` into `umin` (#13790). Ensure i128
;; min/max lower instead of hitting an unsupported-ISLE trap.
function %select_ugt_to_umin() -> i128 system_v {
block0:
    v0 = iconst.i64 0
    v1 = uextend.i128 v0
    v2 = iconst.i64 0
    v3 = iconcat v2, v2
    v4 = isub v3, v1
    v5 = icmp ugt v4, v3
    v6 = select v5, v3, v4
    return v6
}

function %umin_i128(i128, i128) -> i128 system_v {
block0(v0: i128, v1: i128):
    v2 = umin v0, v1
    return v2
}

function %umax_i128(i128, i128) -> i128 system_v {
block0(v0: i128, v1: i128):
    v2 = umax v0, v1
    return v2
}

function %smin_i128(i128, i128) -> i128 system_v {
block0(v0: i128, v1: i128):
    v2 = smin v0, v1
    return v2
}

function %smax_i128(i128, i128) -> i128 system_v {
block0(v0: i128, v1: i128):
    v2 = smax v0, v1
    return v2
}
