test compile precise-output
target x86_64

;; Operands deliberately arrive outside r11/rdi so the pinning moves show.
function %interrupt_poll(i64, i64, i64) -> i64 tail {
block0(v0: i64, v1: i64, v2: i64):
    v3 = interrupt_poll v1, v2, user3
    return v3
}

