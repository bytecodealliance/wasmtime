; Disassembled:
; block0: ; offset 0x0
;   pushq %rbp
;   movq %rsp, %rbp
; block1: ; offset 0x4
;   cmpl %esi, %edi
;   .byte 0x62, 0xf4, 0x7c, 0x18, 0x4c, 0xd6, 0x48, 0x89
;   .byte 0xec, 0x5d, 0xc3

function %sel_mem_i64(i64, i64, i64) -> i64 {
block0(v0: i64, v1: i64, v2: i64):
  v3 = load.i64 v0
  v4 = icmp eq v1, v2
  v5 = select v4, v3, v2
  return v5
}

