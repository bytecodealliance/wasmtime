;   .byte 0x62, 0xf4, 0xcc, 0x18, 0x44, 0xd6, 0x62, 0xf4
;   .byte 0xfc, 0x18, 0x01, 0xf2, 0x48, 0x89, 0xec, 0x5d
;   .byte 0xc3

function %sel_i32(i32, i32, i32) -> i32 {
block0(v0: i32, v1: i32, v2: i32):
  v3 = icmp slt v0, v1
  v4 = select v3, v1, v2
  return v4
}

