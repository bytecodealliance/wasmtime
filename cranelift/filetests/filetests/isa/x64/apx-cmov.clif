;   .byte 0x62, 0xf4, 0xfc, 0x18, 0x44, 0x17, 0x48, 0x89 ; trap: heap_oob
;   .byte 0xec, 0x5d, 0xc3

function %sel_i8(i8, i8, i8) -> i8 {
block0(v0: i8, v1: i8, v2: i8):
  v3 = icmp ugt v0, v1
  v4 = select v3, v1, v2
  return v4
}

