test compile precise-output
set opt_level=none
target x86_64 has_apx

;; APX gives `cmov` a separate destination, so the "else" value no longer has to
;; be copied into the register the move writes.

; want: cmove with three operands, no preceding mov
function %sel_i64(i64, i64, i64) -> i64 {
block0(v0: i64, v1: i64, v2: i64):
  v3 = icmp eq v0, v1
  v4 = select v3, v1, v2
  return v4
}

; VCode:
;   pushq %rbp
;   movq %rsp, %rbp
; block0:
;   cmpq %rsi, %rdi
;   cmoveq %rsi, %rdx, %rax
;   movq %rbp, %rsp
;   popq %rbp
;   retq
;
; Disassembled:
; block0: ; offset 0x0
;   pushq %rbp
;   movq %rsp, %rbp
; block1: ; offset 0x4
;   cmpq %rsi, %rdi
;   .byte 0x62, 0xf4, 0xfc, 0x18, 0x44, 0xd6, 0x48, 0x89
;   .byte 0xec, 0x5d, 0xc3

function %sel_live_i64(i64, i64, i64) -> i64 {
block0(v0: i64, v1: i64, v2: i64):
  v3 = icmp eq v0, v1
  v4 = select v3, v1, v2
  v5 = iadd v4, v2
  return v5
}

