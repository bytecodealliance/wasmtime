;   pushq %rbp
;   movq %rsp, %rbp
; block0:
;   subq %rsi, %rdi, %rax
;   setb %dl
;   movq %rbp, %rsp
;   popq %rbp
;   retq
;
; Disassembled:
; block0: ; offset 0x0
;   pushq %rbp
;   movq %rsp, %rbp
; block1: ; offset 0x4
;   .byte 0x62, 0xf4, 0xfc, 0x18, 0x2b, 0xfe, 0x0f, 0x92
;   .byte 0xc2, 0x48, 0x89, 0xec, 0x5d, 0xc3

