; A tail function that grows its incoming argument area for a
; return_call: the clobbers are still just below the (moved) frame pointer.
function %tail_grow(i64, i64, i64) -> i64 tail {
    sig0 = () windows_fastcall
    sig1 = (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> i64 tail
block0(v0: i64, v1: i64, v2: i64):
    v11 = load.i64 notrap aligned v1+0
    v12 = load.i64 notrap aligned v1+8
    v13 = load.i64 notrap aligned v1+16
    v14 = load.i64 notrap aligned v1+24
    v15 = load.i64 notrap aligned v1+32
    call_indirect sig0, v0()
    v16 = iadd v11, v12
    v17 = iadd v16, v13
    v18 = iadd v17, v14
    v19 = iadd v18, v15
    return_call_indirect sig1, v2(v19, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0)
}

