; Every windows_fastcall callee-saved register: 7 GPRs and 10 XMM
; registers (224-byte clobber area, frame register offset 14).
function %fastcall_f(i64, i64) -> i64 windows_fastcall {
    sig0 = () windows_fastcall
block0(v0: i64, v1: i64):
    v11 = load.i64 notrap aligned v1+0
    v12 = load.i64 notrap aligned v1+8
    v13 = load.i64 notrap aligned v1+16
    v14 = load.i64 notrap aligned v1+24
    v15 = load.i64 notrap aligned v1+32
    v16 = load.i64 notrap aligned v1+40
    v17 = load.i64 notrap aligned v1+48
    v18 = load.f64 notrap aligned v1+56
    v19 = load.f64 notrap aligned v1+64
    v20 = load.f64 notrap aligned v1+72
    v21 = load.f64 notrap aligned v1+80
    v22 = load.f64 notrap aligned v1+88
    v23 = load.f64 notrap aligned v1+96
    v24 = load.f64 notrap aligned v1+104
    v25 = load.f64 notrap aligned v1+112
    v26 = load.f64 notrap aligned v1+120
    v27 = load.f64 notrap aligned v1+128
    call_indirect sig0, v0()
    v28 = iadd v11, v12
    v29 = iadd v28, v13
    v30 = iadd v29, v14
    v31 = iadd v30, v15
    v32 = iadd v31, v16
    v33 = iadd v32, v17
    v34 = fadd v18, v19
    v35 = fadd v34, v20
    v36 = fadd v35, v21
    v37 = fadd v36, v22
    v38 = fadd v37, v23
    v39 = fadd v38, v24
    v40 = fadd v39, v25
    v41 = fadd v40, v26
    v42 = fadd v41, v27
    v43 = fcvt_to_sint_sat.i64 v42
    v44 = iadd v33, v43
    return v44
}

