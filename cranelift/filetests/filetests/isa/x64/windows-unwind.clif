; Three GPRs saved (32-byte clobber area).
function %small(i64, i64) -> i64 windows_fastcall {
    fn0 = %g() windows_fastcall
block0(v0: i64, v1: i64):
    call fn0()
    v2 = iadd v0, v1
    return v2
}

