; Windows x64 unwind info. The frame base that `UWOP_SAVE_NONVOL` (scaled by
; 8) and `UWOP_SAVE_XMM128` (scaled by 16) offsets are measured from is
; `rbp - 16 * frame register offset`, which is the bottom of the clobber
; area. The `SmallStackAlloc` at the same prologue offset as
; `SetFramePointer` compensates for the frame register offset so that
; unwinding `SetFramePointer` still recovers RSP == RBP.
test unwind
set unwind_info=true
set preserve_frame_pointers=true
target x86_64-pc-windows-msvc

; Five GPRs and one XMM register saved (64-byte clobber area).
function %f(i64, i64) -> i64 windows_fastcall {
    fn0 = %g() windows_fastcall
block0(v0: i64, v1: i64):
    v2 = iadd v0, v1
    v3 = imul v0, v1
    v4 = isub v0, v1
    v5 = f64const 0x1.0
    call fn0()
    v6 = iadd v2, v3
    v7 = iadd v6, v4
    v8 = fcvt_to_sint.i64 v5
    v9 = iadd v7, v8
    v10 = iadd v9, v0
    v11 = iadd v10, v1
    return v11
}

