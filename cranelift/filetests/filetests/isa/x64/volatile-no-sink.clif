test compile precise-output
target x86_64

;; A volatile load is never folded into the memory operand of its user: each
;; one stays a separate access of its own width.

function %volatile_add(i64, i32) -> i32 {
block0(v0: i64, v1: i32):
    v2 = load.i32 notrap volatile v0
    v3 = iadd.i32 v2, v1
    return v3
}

; VCode:
;   pushq %rbp
;   movq %rsp, %rbp
; block0:
;   movl (%rdi), %edi
;   leal (%rdi, %rsi), %eax
;   movq %rbp, %rsp
;   popq %rbp
;   retq
;
; Disassembled:
; block0: ; offset 0x0
;   pushq %rbp
;   movq %rsp, %rbp
; block1: ; offset 0x4
;   movl (%rdi), %edi
;   leal (%rdi, %rsi), %eax
;   movq %rbp, %rsp
;   popq %rbp
;   retq

function %volatile_fadd(i64, f32) -> f32 {
block0(v0: i64, v1: f32):
    v2 = load.f32 notrap volatile v0
    v3 = fadd.f32 v1, v2
    return v3
}

