; `stack_addr` is ordinary pointer arithmetic, so its offset may point
; anywhere, including before or after the stack slot. Offsets that are too
; large to fold into the stack slot's address are added separately.
test compile precise-output
target x86_64

function %negative_offset() -> i64 {
    ss0 = explicit_slot 8
    ss1 = explicit_slot 8
block0:
    v0 = stack_addr.i64 ss1-8
    return v0
}

; VCode:
;   pushq %rbp
;   movq %rsp, %rbp
;   subq $0x10, %rsp
; block0:
;   leaq <offset:1>+(%rsp), %rax
;   addq $0x10, %rsp
;   movq %rbp, %rsp
;   popq %rbp
;   retq
;
; Disassembled:
; block0: ; offset 0x0
;   pushq %rbp
;   movq %rsp, %rbp
;   subq $0x10, %rsp
; block1: ; offset 0x8
;   leaq (%rsp), %rax
;   addq $0x10, %rsp
;   movq %rbp, %rsp
;   popq %rbp
;   retq

function %offset_past_slot() -> i64 {
    ss0 = explicit_slot 8
    ss1 = explicit_slot 8
block0:
    v0 = stack_addr.i64 ss0+16
    return v0
}

; VCode:
;   pushq %rbp
;   movq %rsp, %rbp
;   subq $0x10, %rsp
; block0:
;   leaq <offset:1>+0x10(%rsp), %rax
;   addq $0x10, %rsp
;   movq %rbp, %rsp
;   popq %rbp
;   retq
;
; Disassembled:
; block0: ; offset 0x0
;   pushq %rbp
;   movq %rsp, %rbp
;   subq $0x10, %rsp
; block1: ; offset 0x8
;   leaq 0x10(%rsp), %rax
;   addq $0x10, %rsp
;   movq %rbp, %rsp
;   popq %rbp
;   retq

function %large_offset() -> i64 {
    ss0 = explicit_slot 8
    ss1 = explicit_slot 8
block0:
    v0 = stack_addr.i64 ss1+2147483647
    return v0
}

; VCode:
;   pushq %rbp
;   movq %rsp, %rbp
;   subq $0x10, %rsp
; block0:
;   leaq <offset:1>+8(%rsp), %rax
;   movl $0x7fffffff, %edx
;   addq %rdx, %rax
;   addq $0x10, %rsp
;   movq %rbp, %rsp
;   popq %rbp
;   retq
;
; Disassembled:
; block0: ; offset 0x0
;   pushq %rbp
;   movq %rsp, %rbp
;   subq $0x10, %rsp
; block1: ; offset 0x8
;   leaq 8(%rsp), %rax
;   movl $0x7fffffff, %edx
;   addq %rdx, %rax
;   addq $0x10, %rsp
;   movq %rbp, %rsp
;   popq %rbp
;   retq

function %large_negative_offset() -> i64 {
    ss0 = explicit_slot 8
    ss1 = explicit_slot 8
block0:
    v0 = stack_addr.i64 ss1-2147483648
    return v0
}

; VCode:
;   pushq %rbp
;   movq %rsp, %rbp
;   subq $0x10, %rsp
; block0:
;   leaq <offset:1>+8(%rsp), %rax
;   movq $0xffffffff80000000, %rdx
;   addq %rdx, %rax
;   addq $0x10, %rsp
;   movq %rbp, %rsp
;   popq %rbp
;   retq
;
; Disassembled:
; block0: ; offset 0x0
;   pushq %rbp
;   movq %rsp, %rbp
;   subq $0x10, %rsp
; block1: ; offset 0x8
;   leaq 8(%rsp), %rax
;   movq $18446744071562067968, %rdx
;   addq %rdx, %rax
;   addq $0x10, %rsp
;   movq %rbp, %rsp
;   popq %rbp
;   retq

function %large_offset_load() -> i64 {
    ss0 = explicit_slot 8
    ss1 = explicit_slot 8
block0:
    v0 = stack_addr.i64 ss1+2147483647
    v1 = load.i64 notrap v0-2147483648
    return v1
}

