; Cranelift-generated trampolines must agree with Winch about who pops
; incoming stack arguments, including indirect calls.
test compile precise-output
target x86_64

function %callee(i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> i64 winch {
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64, v6: i64, v7: i64, v8: i64, v9: i64):
    v10 = iadd v0, v9
    return v10
}

; VCode:
;   pushq %rbp
;   movq %rsp, %rbp
; block0:
;   movq <offset:0>+-8(%rbp), %rdx
;   leaq (%rdi, %rdx), %rax
;   movq %rbp, %rsp
;   popq %rbp
;   retq $0x20
;
; Disassembled:
; block0: ; offset 0x0
;   pushq %rbp
;   movq %rsp, %rbp
; block1: ; offset 0x4
;   movq 0x28(%rbp), %rdx
;   leaq (%rdi, %rdx), %rax
;   movq %rbp, %rsp
;   popq %rbp
;   retq $0x20

function %caller() -> i64 system_v {
    sig0 = (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> i64 winch
    fn0 = colocated %callee sig0
block0:
    v0 = iconst.i64 42
    v1 = call fn0(v0, v0, v0, v0, v0, v0, v0, v0, v0, v0)
    v2 = iadd v1, v0
    return v2
}

