function %indirect_caller(i64) -> i64 system_v {
    sig0 = (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> i64 winch
block0(v0: i64):
    v1 = iconst.i64 42
    v2 = call_indirect sig0, v0(v1, v1, v1, v1, v1, v1, v1, v1, v1, v1)
    v3 = iadd v2, v1
    return v3
}

