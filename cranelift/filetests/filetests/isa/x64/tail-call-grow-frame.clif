; A `tail` function that grows its incoming argument area for a
; `return_call` with more stack arguments than it received. The frame is
; defined for unwinding before the saved RBP and return address are moved,
; and RBP is only updated once both have been moved.
test compile precise-output
set unwind_info=true
set preserve_frame_pointers=true
target x86_64-unknown-linux-gnu

function %f(i64) -> i64 tail {
    fn0 = %g(i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> i64 tail
    fn1 = %h() -> i64 tail
block0(v0: i64):
    v1 = call fn1()
    v2 = call fn1()
    v3 = iadd v0, v1
    v4 = call fn1()
    v5 = iadd v3, v2
    v6 = iadd v5, v4
    return_call fn0(v6, v0, v1, v2, v3, v4, v5, v6, v0, v1)
}

