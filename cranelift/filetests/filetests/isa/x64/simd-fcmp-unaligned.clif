test compile precise-output
target x86_64

function %fcmp_eq_f32x4_load(f32x4, i64) -> i32x4 {
block0(v0: f32x4, v1: i64):
    v2 = load.f32x4 v1+1
    v3 = fcmp eq v0, v2
    return v3
}

