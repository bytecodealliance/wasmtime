; Inline stack probes in a `preserve_all` function must not clobber any
; registers, since they run before registers are saved. With five or more
; probes, other ABIs use a probe loop with %r11 as a temporary;
; `preserve_all` always uses the unrolled probes, which use no registers.
test compile precise-output
set enable_probestack=true
set probestack_strategy=inline
target x86_64

function %preserve_all(i64) preserve_all {
    ss0 = explicit_slot 20480
block0(v0: i64):
    v1 = stack_addr.i64 ss0
    store v0, v1
    return
}

