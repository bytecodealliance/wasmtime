;   subq $0x1000, %rsp
;   movl $0x0, (%rsp)
;   subq $0x1000, %rsp
;   movl $0x0, (%rsp)
;   addq $0x5000, %rsp
;   subq $0x5010, %rsp
;   movq %rdi, 0x5000(%rsp)
; block0:
;   movq %rdi, <offset:1>+(%rsp)
;   movq 0x5000(%rsp), %rdi
