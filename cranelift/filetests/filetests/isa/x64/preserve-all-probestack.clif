;   subq $0x1000, %rsp
;   movl $0, (%rsp)
;   subq $0x1000, %rsp
;   movl $0, (%rsp)
;   subq $0x1000, %rsp
;   movl $0, (%rsp)
;   subq $0x1000, %rsp
;   movl $0, (%rsp)
;   subq $0x1000, %rsp
;   movl $0, (%rsp)
;   addq $0x5000, %rsp
;   subq $0x5010, %rsp
;   movq %rdi, 0x5000(%rsp)
; block1: ; offset 0x60
;   movq %rdi, (%rsp)
;   movq 0x5000(%rsp), %rdi
;   addq $0x5010, %rsp
;   movq %rbp, %rsp
;   popq %rbp
;   retq

function %system_v(i64) system_v {
    ss0 = explicit_slot 20480
block0(v0: i64):
    v1 = stack_addr.i64 ss0
    store v0, v1
    return
}

