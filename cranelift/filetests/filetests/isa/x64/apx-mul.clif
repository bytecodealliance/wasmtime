; block1: ; offset 0x4
;   imulq $0xa, %rdi, %rax
;   movq %rbp, %rsp
;   popq %rbp
;   retq

function %mul_i16(i16, i16) -> i16 {
block0(v0: i16, v1: i16):
    v2 = imul v0, v1
    return v2
}

