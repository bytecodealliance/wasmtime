test compile precise-output
target x86_64 has_apx

; APX NDD multiply. The two-operand `imul` writes over one of its inputs, so
; preserving both costs a move first; the NDD form takes a third register.
;
; The immediate forms already have a separate destination and are unchanged.

; want: one instruction, rax = rdi * rsi
function %mul_i64(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    v2 = imul v0, v1
    return v2
}

; VCode:
;   pushq %rbp
;   movq %rsp, %rbp
; block0:
;   imulq %rsi, %rdi, %rax
;   movq %rbp, %rsp
;   popq %rbp
;   retq
;
; Disassembled:
; block0: ; offset 0x0
;   pushq %rbp
;   movq %rsp, %rbp
; block1: ; offset 0x4
;   .byte 0x62, 0xf4, 0xfc, 0x18, 0xaf, 0xfe, 0x48, 0x89
;   .byte 0xec, 0x5d, 0xc3

function %mul_i32(i32, i32) -> i32 {
block0(v0: i32, v1: i32):
    v2 = imul v0, v1
    return v2
}

; VCode:
;   pushq %rbp
;   movq %rsp, %rbp
; block0:
;   imull %esi, %edi, %eax
;   movq %rbp, %rsp
;   popq %rbp
;   retq
;
; Disassembled:
; block0: ; offset 0x0
;   pushq %rbp
;   movq %rsp, %rbp
; block1: ; offset 0x4
;   .byte 0x62, 0xf4, 0x7c, 0x18, 0xaf, 0xfe, 0x48, 0x89
;   .byte 0xec, 0x5d, 0xc3

function %mul_mem_i64(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    v2 = load.i64 v1
    v3 = imul v0, v2
    return v3
}

; VCode:
;   pushq %rbp
;   movq %rsp, %rbp
; block0:
;   imulq (%rsi), %rdi, %rax
;   movq %rbp, %rsp
;   popq %rbp
;   retq
;
; Disassembled:
; block0: ; offset 0x0
;   pushq %rbp
;   movq %rsp, %rbp
; block1: ; offset 0x4
;   .byte 0x62, 0xf4, 0xfc, 0x18, 0xaf, 0x3e, 0x48, 0x89 ; trap: heap_oob
;   .byte 0xec, 0x5d, 0xc3

function %mul_mem_i32(i64, i32) -> i32 {
block0(v0: i64, v1: i32):
    v2 = load.i32 v0
    v3 = imul v1, v2
    return v3
}

; VCode:
;   pushq %rbp
;   movq %rsp, %rbp
; block0:
;   imull (%rdi), %esi, %eax
;   movq %rbp, %rsp
;   popq %rbp
;   retq
;
; Disassembled:
; block0: ; offset 0x0
;   pushq %rbp
;   movq %rsp, %rbp
; block1: ; offset 0x4
;   .byte 0x62, 0xf4, 0x7c, 0x18, 0xaf, 0x37, 0x48, 0x89 ; trap: heap_oob
;   .byte 0xec, 0x5d, 0xc3

function %mul_imm_i64(i64) -> i64 {
block0(v0: i64):
    v1 = iconst.i64 10
    v2 = imul v0, v1
    return v2
}

