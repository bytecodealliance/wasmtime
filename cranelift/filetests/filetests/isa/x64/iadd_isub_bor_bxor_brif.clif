test compile precise-output
set opt_level=speed
target x86_64

;; Branching on the result of a 32- or 64-bit `iadd`, `isub`, `bor` or `bxor`
;; being nonzero uses the flags set by the operation itself, without a separate
;; `test` of the result (issue #11125). 8- and 16-bit values still use a `test`.

function %iadd_isub_bor_bxor_brif_i32(i32, i32, i32, i32) -> i32 {
block0(v0: i32, v1: i32, v2: i32, v3: i32):
  v4 = iadd v0, v1
  brif v4, block1, block5

block1:
  v5 = isub v0, v2
  brif v5, block2, block5

block2:
  v6 = bor v1, v3
  brif v6, block3, block5

block3:
  v7 = bxor v2, v3
  brif v7, block4, block5

block4:
  v8 = iconst.i32 1
  return v8

block5:
  v9 = iconst.i32 2
  return v9
}

