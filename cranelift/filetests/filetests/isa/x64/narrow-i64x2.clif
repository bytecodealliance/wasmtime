test compile
target x86_64
target x86_64 sse41
target x86_64 sse42
target x86_64 sse42 has_avx

; General i64x2 narrowing, without the fcvt_to_sint_sat special case (#4734).
function %snarrow_i64x2(i64x2, i64x2) -> i32x4 {
block0(v0: i64x2, v1: i64x2):
    v2 = snarrow v0, v1
    return v2
}
; check: retq

function %unarrow_i64x2(i64x2, i64x2) -> i32x4 {
block0(v0: i64x2, v1: i64x2):
    v2 = unarrow v0, v1
    return v2
}
; check: retq

function %snarrow_i64x2_load(i64, i64) -> i32x4 {
block0(v0: i64, v1: i64):
    v2 = load.i64x2 v0
    v3 = load.i64x2 v1
    v4 = snarrow v2, v3
    return v4
}
; check: retq

function %unarrow_i64x2_load(i64, i64) -> i32x4 {
block0(v0: i64, v1: i64):
    v2 = load.i64x2 v0
    v3 = load.i64x2 v1
    v4 = unarrow v2, v3
    return v4
}
; check: retq
