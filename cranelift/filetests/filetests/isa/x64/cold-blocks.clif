;; The edge `block1 -> block3` is a critical edge (`block1` has multiple
;; successors and `block3` has multiple predecessors) so it gets split into its
;; own block. Because its predecessor, `block1`, is cold, that split edge block
;; should be cold as well and placed at the end of the function, alongside
;; `block1`.
function %cold_critical_edge_pred(i32, i32, i32) -> i32 {
block0(v0: i32, v1: i32, v2: i32):
    brif v0, block1, block2

block1 cold:
    brif v0, block3(v2, v1), block4

block2:
    jump block3(v1, v2)

block3(v3: i32, v4: i32):
    v5 = isub v3, v4
    return v5

block4 cold:
    trap user1
}

