;   .byte 0x89, 0xec, 0x5d, 0xc3

function %and_load_lhs_wide_imm(i64) -> i64 {
block0(v0: i64):
    v1 = load.i64 v0
    v2 = iconst.i64 0x1234_5678_9abc
    v3 = band v1, v2
    return v3
}

