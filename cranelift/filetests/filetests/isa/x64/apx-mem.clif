;   movq %rsp, %rbp
; block1: ; offset 0x4
;   movabsq $0x123456789abc, %rsi
;   .byte 0x62, 0xf4, 0xfc, 0x18, 0x21, 0x37, 0x48, 0x89 ; trap: heap_oob
;   .byte 0xec, 0x5d, 0xc3

function %xor_load_both(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    v2 = load.i64 v0
    v3 = load.i64 v1
    v4 = bxor v2, v3
    return v4
}

