;; No frame beyond fp/lr: `PulleyBasicSetup` with a zero-sized frame.
function %no_frame(i64) -> i64 tail {
    fn0 = colocated %callee(i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> i64 tail

block0(v0: i64):
    return_call fn0(v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0)
}

