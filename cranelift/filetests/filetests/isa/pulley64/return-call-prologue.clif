;; Large frame that doesn't fit in a `u16`: `PulleyBasicSetup`.
function %large_frame(i64) -> i64 tail {
    ss0 = explicit_slot 1000000
    fn0 = colocated %callee(i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> i64 tail

block0(v0: i64):
    v2 = stack_addr.i64 ss0
    store v0, v2
    v1 = load.i64 v2
    return_call fn0(v1, v1, v1, v1, v1, v1, v1, v1, v1, v1, v1, v1, v1, v1, v1, v1, v1, v1, v1, v1)
}

