test compile precise-output
set enable_multi_ret_implicit_sret
set unwind_info=false
target riscv64 has_v has_zvfh=false

function %copy_f16x8(i64, i64) {
block0(v0: i64, v1: i64):
    v2 = load.f16x8 v0
    store v2, v1
    return
}

; VCode:
; block0:
;   vle16.v v8,0(a0) #avl=8, #vtype=(e16, m1, ta, ma)
;   vse16.v v8,0(a1) #avl=8, #vtype=(e16, m1, ta, ma)
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   .byte 0x57, 0x70, 0x84, 0xcc
;   .byte 0x07, 0x54, 0x05, 0x02 ; trap: heap_oob
;   .byte 0x27, 0xd4, 0x05, 0x02 ; trap: heap_oob
;   ret

function %bitcast_f16x8_to_i16x8(f16x8) -> i16x8 {
block0(v0: f16x8):
    v1 = bitcast.i16x8 v0
    return v1
}

; VCode:
;   addi sp,sp,-16
;   sd ra,8(sp)
;   sd fp,0(sp)
;   mv fp,sp
; block0:
;   vle8.v v8,-16(incoming_arg) #avl=16, #vtype=(e8, m1, ta, ma)
;   vse8.v v8,0(a0) #avl=16, #vtype=(e8, m1, ta, ma)
;   ld ra,8(sp)
;   ld fp,0(sp)
;   addi sp,sp,16
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   addi sp, sp, -0x10
;   sd ra, 8(sp)
;   sd s0, 0(sp)
;   mv s0, sp
; block1: ; offset 0x10
;   .byte 0x57, 0x70, 0x08, 0xcc
;   addi t6, sp, 0x10
;   .byte 0x07, 0x84, 0x0f, 0x02
;   .byte 0x27, 0x04, 0x05, 0x02
;   ld ra, 8(sp)
;   ld s0, 0(sp)
;   addi sp, sp, 0x10
;   ret

function %bitcast_f16x8_to_i128(f16x8) -> i128 {
block0(v0: f16x8):
    v1 = bitcast.i128 little v0
    return v1
}

; VCode:
;   addi sp,sp,-16
;   sd ra,8(sp)
;   sd fp,0(sp)
;   mv fp,sp
; block0:
;   vle8.v v8,-16(incoming_arg) #avl=16, #vtype=(e8, m1, ta, ma)
;   vmv.x.s a0,v8 #avl=2, #vtype=(e64, m1, ta, ma)
;   vslidedown.vi v8,v8,1 #avl=2, #vtype=(e64, m1, ta, ma)
;   vmv.x.s a1,v8 #avl=2, #vtype=(e64, m1, ta, ma)
;   ld ra,8(sp)
;   ld fp,0(sp)
;   addi sp,sp,16
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   addi sp, sp, -0x10
;   sd ra, 8(sp)
;   sd s0, 0(sp)
;   mv s0, sp
; block1: ; offset 0x10
;   .byte 0x57, 0x70, 0x08, 0xcc
;   addi t6, sp, 0x10
;   .byte 0x07, 0x84, 0x0f, 0x02
;   .byte 0x57, 0x70, 0x81, 0xcd
;   .byte 0x57, 0x25, 0x80, 0x42
;   .byte 0x57, 0xb4, 0x80, 0x3e
;   .byte 0xd7, 0x25, 0x80, 0x42
;   ld ra, 8(sp)
;   ld s0, 0(sp)
;   addi sp, sp, 0x10
;   ret

function %bitcast_i128_to_f16x8(i128) -> f16x8 {
block0(v0: i128):
    v1 = bitcast.f16x8 little v0
    return v1
}

