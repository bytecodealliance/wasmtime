; Inline stack probes in a `preserve_all` function must not clobber any
; allocatable register, since they run before registers are saved. Other ABIs
; use %t3 (x28, allocatable) as the probe temporary, and a probe loop for
; four or more probes; `preserve_all` always uses unrolled probes with the
; non-allocatable spill temporary %t5 (x30).
test compile precise-output
set enable_probestack=true
set probestack_strategy=inline
target riscv64

function %preserve_all(i64) preserve_all {
    ss0 = explicit_slot 20480
block0(v0: i64):
    v1 = stack_addr.i64 ss0
    store v0, v1
    return
}

; VCode:
;   addi sp,sp,-16
;   sd ra,8(sp)
;   sd fp,0(sp)
;   mv fp,sp
;   lui t5,-1
;   add sp,sp,t5
;   sw zero,0(sp)
;   add sp,sp,t5
;   sw zero,0(sp)
;   add sp,sp,t5
;   sw zero,0(sp)
;   add sp,sp,t5
;   sw zero,0(sp)
;   add sp,sp,t5
;   sw zero,0(sp)
;   lui t6,5
;   add sp,sp,t6
;   lui t6,-5
;   addi t6,t6,-16
;   add sp,sp,t6
;   sd a0,20488(sp)
; block0:
;   sd a0,0(slot)
;   ld a0,20488(sp)
;   lui t6,5
;   addi t6,t6,16
;   add sp,sp,t6
;   ld ra,8(sp)
;   ld fp,0(sp)
;   addi sp,sp,16
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   addi sp, sp, -0x10
;   sd ra, 8(sp)
;   sd s0, 0(sp)
;   mv s0, sp
;   lui t5, 0xfffff
;   add sp, sp, t5
;   sw zero, 0(sp)
;   add sp, sp, t5
;   sw zero, 0(sp)
;   add sp, sp, t5
;   sw zero, 0(sp)
;   add sp, sp, t5
;   sw zero, 0(sp)
;   add sp, sp, t5
;   sw zero, 0(sp)
;   lui t6, 5
;   add sp, sp, t6
;   lui t6, 0xffffb
;   addi t6, t6, -0x10
;   add sp, sp, t6
;   lui t6, 5
;   addi t6, t6, 8
;   add t6, t6, sp
;   sd a0, 0(t6)
; block1: ; offset 0x60
;   sd a0, 0(sp) ; trap: heap_oob
;   lui t6, 5
;   addi t6, t6, 8
;   add t6, t6, sp
;   ld a0, 0(t6)
;   lui t6, 5
;   addi t6, t6, 0x10
;   add sp, sp, t6
;   ld ra, 8(sp)
;   ld s0, 0(sp)
;   addi sp, sp, 0x10
;   ret

function %system_v(i64) system_v {
    ss0 = explicit_slot 20480
block0(v0: i64):
    v1 = stack_addr.i64 ss0
    store v0, v1
    return
}

