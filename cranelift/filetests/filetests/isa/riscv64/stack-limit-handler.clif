test compile precise-output
set unwind_info=false
set enable_multi_ret_implicit_sret
target riscv64

function %foo() {
block0:
    return
}

; VCode:
; block0:
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   ret

;; A leaf function with no frame needs no stack check at all, even with a
;; handler.
function %handler_leaf_zero(i64 vmctx) tail {
    gv0 = vmctx
    gv1 = load.i64 notrap aligned gv0
    gv2 = load.i64 notrap aligned gv1+8
    stack_limit = gv2, handler = fn0
    fn0 = colocated %overflow(i64 vmctx) tail
block0(v0: i64):
    return
}

; VCode:
; block0:
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   ret

;; A function that makes calls: the check happens before any frame setup and
;; tail-calls the handler on overflow.
function %handler_call_zero(i64 vmctx) tail {
    gv0 = vmctx
    gv1 = load.i64 notrap aligned gv0
    gv2 = load.i64 notrap aligned gv1+8
    stack_limit = gv2, handler = fn1
    fn0 = %foo()
    fn1 = colocated %overflow(i64 vmctx) tail
block0(v0: i64):
    call fn0()
    return
}

