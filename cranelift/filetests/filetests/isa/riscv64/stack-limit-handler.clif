;   addi sp,sp,-16
;   sd ra,8(sp)
;   sd fp,0(sp)
;   mv fp,sp
; block0:
;   load_ext_name_far a0,%foo+0
;   callind a0
;   ld ra,8(sp)
;   ld fp,0(sp)
;   addi sp,sp,16
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   ld t6, 0(a0)
;   ld t6, 8(t6)
;   addi t6, t6, 0x20
;   bgeu sp, t6, 0xc
;   auipc t6, 0 ; reloc_external RiscvCallPlt %overflow 0
;   jr t6
;   addi sp, sp, -0x10
;   sd ra, 8(sp)
;   sd s0, 0(sp)
;   mv s0, sp
; block1: ; offset 0x28
;   auipc a0, 0
;   ld a0, 0xc(a0)
;   j 0xc
;   .byte 0x00, 0x00, 0x00, 0x00 ; reloc_external Abs8 %foo 0
;   .byte 0x00, 0x00, 0x00, 0x00
;   jalr a0
;   ld ra, 8(sp)
;   ld s0, 0(sp)
;   addi sp, sp, 0x10
;   ret

;; The handler's parameters need only be a prefix of the function's, and the
;; stack limit can be the vmctx itself.
function %handler_prefix_params(i64 vmctx, i64, i64) -> i64 tail {
    gv0 = vmctx
    stack_limit = gv0, handler = fn1
    fn0 = %foo()
    fn1 = colocated %overflow(i64 vmctx) tail
block0(v0: i64, v1: i64, v2: i64):
    call fn0()
    v3 = iadd v1, v2
    return v3
}

