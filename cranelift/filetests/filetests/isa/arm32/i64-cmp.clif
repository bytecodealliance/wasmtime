function %br_sle(i64, i64) -> i32 {
block0(v0: i64, v1: i64):
    v2 = icmp sle v0, v1
    brif v2, block1, block2
block1:
    v3 = iconst.i32 1
    return v3
block2:
    v4 = iconst.i32 0
    return v4
}

