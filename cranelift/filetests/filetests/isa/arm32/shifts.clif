test compile precise-output
target arm

function %shl_imm(i32) -> i32 {
block0(v0: i32):
    v1 = iconst.i32 3
    v2 = ishl v0, v1
    return v2
}

; VCode:
; block0:
;   lsl r0, r0, #3
;   bx lr
;
; Disassembled:
; block0: ; offset 0x0
;   lsl r0, r0, #3
;   bx lr

function %shl_reg(i32, i32) -> i32 {
block0(v0: i32, v1: i32):
    v2 = ishl v0, v1
    return v2
}

