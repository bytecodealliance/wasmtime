test compile precise-output
target arm

function %select_via_brif(i32, i32) -> i32 {
block0(v0: i32, v1: i32):
    v2 = icmp slt v0, v1
    brif v2, block1, block2

block1:
    v3 = iconst.i32 1
    return v3

block2:
    v4 = iconst.i32 0
    return v4
}

