;; 64-bit: paired exclusive loop with a carry chain. All registers are pinned
;; to a fixed even/odd layout (r0/r1 old, r2/r3 new, r4 addr, r5/r6 operand,
;; r7 result) because A32 `ldrexd`/`strexd` require consecutive pairs.
function %rmw_add_i64(i32, i64) -> i64 {
block0(v0: i32, v1: i64):
    v2 = atomic_rmw.i64 add v0, v1
    return v2
}

