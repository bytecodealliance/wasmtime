;   add sp, sp, #0x10
;   pop {fp, lr}
;   bx lr

;; 64-bit signed max: a subs/sbcs compare then a conditional select of both
;; halves.
function %rmw_smax_i64(i32, i64) -> i64 {
block0(v0: i32, v1: i64):
    v2 = atomic_rmw.i64 smax v0, v1
    return v2
}

