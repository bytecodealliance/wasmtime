function %flt_br(f32, f32) -> i32 {
block0(v0: f32, v1: f32):
    v2 = fcmp lt v0, v1
    brif v2, block1, block2
block1:
    v3 = iconst.i32 1
    return v3
block2:
    v4 = iconst.i32 0
    return v4
}

