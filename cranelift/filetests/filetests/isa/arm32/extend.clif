test compile precise-output
target arm

function %sext8(i8) -> i32 {
block0(v0: i8):
    v1 = sextend.i32 v0
    return v1
}

; VCode:
; block0:
;   sxtb r0, r0
;   bx lr
;
; Disassembled:
; block0: ; offset 0x0
;   sxtb r0, r0
;   bx lr

