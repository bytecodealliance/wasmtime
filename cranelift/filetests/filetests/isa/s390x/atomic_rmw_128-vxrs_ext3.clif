test compile precise-output
set enable_multi_ret_implicit_sret
target s390x has_vxrs_ext3

function %atomic_rmw_smin_i128(i64, i64, i128) -> i128 {
block0(v0: i64, v1: i64, v2: i128):
  v3 = atomic_rmw.i128 smin v1, v2
  return v3
}

