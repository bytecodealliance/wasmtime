test compile precise-output
set unwind_info=false
set is_pic
target s390x

function %func_addr() -> i64 {
    fn0 = %my_func(i64) -> i64

block0:
    v0 = func_addr.i64 fn0
    return v0
}

; VCode:
; block0:
;   lgrl %r2, %my_func@GOTENT
;   br %r14
;
; Disassembled:
; block0: ; offset 0x0
;   lgrl %r2, 0 ; reloc_external GOTRel32Dbl %my_func 2
;   br %r14

function %colocated_func_addr() -> i64 {
    fn0 = colocated %my_func(i64) -> i64

block0:
    v0 = func_addr.i64 fn0
    return v0
}

; VCode:
