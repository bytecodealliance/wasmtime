;; The handler's parameters need only be a prefix of the function's, and the
;; stack limit can be the vmctx itself.
function %handler_prefix_params(i64 vmctx, i64, i64) -> i64 tail {
    gv0 = vmctx
    stack_limit = gv0, handler = fn1
    fn0 = %foo()
    fn1 = colocated %overflow(i64 vmctx) tail
block0(v0: i64, v1: i64, v2: i64):
    call fn0()
    v3 = iadd v1, v2
    return v3
}

