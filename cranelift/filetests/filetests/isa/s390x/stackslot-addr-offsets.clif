;   aghi %r15, -16
; block0:
;   la %r2, 8(%r15)
;   lgfi %r3, 2147483647
;   agrk %r5, %r2, %r3
;   lgfi %r1, -2147483648 ; lg %r2, 0(%r1,%r5)
;   aghi %r15, 16
;   br %r14
;
; Disassembled:
; block0: ; offset 0x0
;   aghi %r15, -0x10
; block1: ; offset 0x4
;   la %r2, 8(%r15)
;   lgfi %r3, 0x7fffffff
;   agrk %r5, %r2, %r3
;   lgfi %r1, -0x80000000
;   lg %r2, 0(%r1, %r5)
;   aghi %r15, 0x10
;   br %r14

