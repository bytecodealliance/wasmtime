function %two_constants(i64x2) -> i64x2 {
block0(v0: i64x2):
  v1 = vconst.i64x2 [1 2]
  v2 = vconst.i64x2 [3 4]
  v3 = iadd v0, v1
  v4 = bxor v3, v2
  return v4
}

