; block0: ; offset 0x0
;   larl %r1, 0 ; reloc_constant PCRel32Dbl constant0 2
;   vl %v24, 0(%r1)
;   br %r14
; constant0: ; offset 0x0
;   .byte 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01
;   .byte 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x02

function %two_uses(i64x2) -> i64x2 {
block0(v0: i64x2):
  v1 = vconst.i64x2 [1 2]
  v2 = iadd v0, v1
  v3 = bxor v2, v1
  return v3
}

