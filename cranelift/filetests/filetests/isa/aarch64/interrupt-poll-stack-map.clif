test compile precise-output
target aarch64

;; The stack map attached to an `interrupt_poll` must be emitted at the address
;; of the faulting load, because the MMU-interruption handler resumes by
;; re-executing that load and records its address as the Wasm resume PC.
function %interrupt_poll_stack_map(i64, i64, i64) -> i64 tail {
    ss0 = explicit_slot 8, align = 8
block0(v0: i64, v1: i64, v2: i64):
    v3 = stack_addr.i64 ss0
    store notrap v0, v3
    v4 = interrupt_poll v1, v2, user3, stack_map=[i64 @ ss0+0]
    return v4
}

; VCode:
