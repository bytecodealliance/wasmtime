;   mov x0, x4
;   mov x10, x3
;   x10 = interrupt_poll load_ptr=x10, context=x0, scratch=x9 #trap=user3
;   ; UserStackMap { by_type: [(types::I64, CompoundBitSet {0})], sp_to_sized_stack_slots: None }
;   mov x2, x10
;   add sp, sp, #16
;   ldp fp, lr, [sp], #16
;   ret
