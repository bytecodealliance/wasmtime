;; The `tail` calling convention, as used by Wasmtime, with stack arguments.
function %handler_tail(i64 vmctx, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> i64 tail {
    ss0 = explicit_slot 8
    gv0 = vmctx
    gv1 = load.i64 notrap aligned gv0
    gv2 = load.i64 notrap aligned gv1+8
    stack_limit = gv2, handler = fn0
    fn0 = colocated %overflow(i64 vmctx) tail
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64, v6: i64, v7: i64, v8: i64, v9: i64, v10: i64):
    v11 = iadd v1, v10
    v13 = stack_addr.i64 ss0
    store v11, v13
    v12 = load.i64 v13
    return v12
}

