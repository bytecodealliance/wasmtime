test compile precise-output
set unwind_info=false
set enable_multi_ret_implicit_sret
target aarch64

function %foo() {
block0:
    return
}

; VCode:
; block0:
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   ret

;; A leaf function with no frame needs no stack check at all, even with a
;; handler.
function %handler_leaf_zero(i64 vmctx) tail {
    gv0 = vmctx
    gv1 = load.i64 notrap aligned gv0
    gv2 = load.i64 notrap aligned gv1+8
    stack_limit = gv2, handler = fn0
    fn0 = colocated %overflow(i64 vmctx) tail
block0(v0: i64):
    return
}

; VCode:
; block0:
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   ret

;; A function that makes calls: the check happens before any frame setup and
;; tail-calls the handler on overflow.
function %handler_call_zero(i64 vmctx) tail {
    gv0 = vmctx
    gv1 = load.i64 notrap aligned gv0
    gv2 = load.i64 notrap aligned gv1+8
    stack_limit = gv2, handler = fn1
    fn0 = %foo()
    fn1 = colocated %overflow(i64 vmctx) tail
block0(v0: i64):
    call fn0()
    return
}

; VCode:
;   ldr x16, [x2]
;   ldr x16, [x16, #8]
;   add x16, x16, #32
;   subs xzr, sp, x16, UXTX ; b.hs $ok ; b TestCase(%overflow) ; $ok:
;   stp fp, lr, [sp, #-16]!
;   mov fp, sp
; block0:
;   load_ext_name_far x0, TestCase(%foo)+0
;   blr x0
;   ldp fp, lr, [sp], #16
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   ldur x16, [x2]
;   ldur x16, [x16, #8]
;   add x16, x16, #0x20
;   cmp sp, x16
;   b.hs #0x18
;   b #0x14 ; reloc_external Call %overflow 0
;   stp x29, x30, [sp, #-0x10]!
;   mov x29, sp
; block1: ; offset 0x20
;   ldr x0, #0x28
;   b #0x30
;   udf #0 ; reloc_external Abs8 %foo 0
;   udf #0
;   blr x0
;   ldp x29, x30, [sp], #0x10
;   ret

;; The handler's parameters need only be a prefix of the function's, and the
;; stack limit can be the vmctx itself.
function %handler_prefix_params(i64 vmctx, i64, i64) -> i64 tail {
    gv0 = vmctx
    stack_limit = gv0, handler = fn1
    fn0 = %foo()
    fn1 = colocated %overflow(i64 vmctx) tail
block0(v0: i64, v1: i64, v2: i64):
    call fn0()
    v3 = iadd v1, v2
    return v3
}

