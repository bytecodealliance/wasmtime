test compile precise-output
target aarch64 has_lse

function %atomic_cas_i128(i64, i128, i128) -> i128 {
block0(v0: i64, v1: i128, v2: i128):
    v3 = atomic_cas.i128 v0, v1, v2
    return v3
}

