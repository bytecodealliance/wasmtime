block0(v0: i64, v1: i64):
    v2 = uextend.i128 v0
    v3 = uextend.i128 v1
    v4 = imul v2, v3
    v7 = iconst.i64 64
    v8 = uextend.i128 v7
    v5 = ushr v4, v8
    v6 = ireduce.i64 v5
    return v6
}

