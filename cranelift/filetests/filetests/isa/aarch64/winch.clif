; block0: ; offset 0x0
;   stp x29, x30, [sp, #-0x10]!
;   mov x29, sp
; block1: ; offset 0x8
;   bl #8 ; reloc_external Call %direct_callee 0
;   ldp x29, x30, [sp], #0x10
;   ret

function %indirect_winch_call(i64) winch {
    sig0 = () winch

block0(v0: i64):
    call_indirect sig0, v0()
    return
}

