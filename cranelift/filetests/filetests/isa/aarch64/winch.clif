;   mov x29, sp
; block1: ; offset 0x8
;   blr x0
;   ldp x29, x30, [sp], #0x10
;   ret

function %try_winch_call() -> i32 winch {
    sig0 = () winch
    fn0 = colocated %try_callee sig0

block0:
    try_call fn0(), sig0, block1(), [ default: block2 ]

block1:
    v0 = iconst.i32 0
    return v0

block2:
    v1 = iconst.i32 1
    return v1
}

