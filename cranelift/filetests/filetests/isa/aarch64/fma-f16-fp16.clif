test compile precise-output
set unwind_info=false
target aarch64 has_fp16

function %fma(f16, f16, f16) -> f16 {
block0(v0: f16, v1: f16, v2: f16):
    v3 = fma v0, v1, v2
    return v3
}

; VCode:
; block0:
;   fmadd h0, h0, h1, h2
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   fmadd h0, h0, h1, h2
;   ret

function %fmsub(f16, f16, f16) -> f16 {
block0(v0: f16, v1: f16, v2: f16):
    v3 = fneg v2
    v4 = fma v0, v1, v3
    return v4
}

; VCode:
; block0:
;   fnmsub h0, h0, h1, h2
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   fnmsub h0, h0, h1, h2
;   ret

function %fnmsub(f16, f16, f16) -> f16 {
block0(v0: f16, v1: f16, v2: f16):
    v3 = fneg v0
    v4 = fma v3, v1, v2
    return v4
}

; VCode:
; block0:
;   fmsub h0, h0, h1, h2
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   fmsub h0, h0, h1, h2
;   ret

function %fnmadd(f16, f16, f16) -> f16 {
block0(v0: f16, v1: f16, v2: f16):
    v3 = fneg v0
    v4 = fneg v2
    v5 = fma v3, v1, v4
    return v5
}

; VCode:
; block0:
;   fnmadd h0, h0, h1, h2
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   fnmadd h0, h0, h1, h2
;   ret

