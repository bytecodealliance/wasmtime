test compile precise-output
target aarch64

function %atomic_load_i128(i64) -> i128 {
block0(v0: i64):
  v1 = atomic_load.i128 v0
  return v1
}

; VCode:
; block0:
;   mov x5, x0
;   load_acquire_128 x0, x1, [x5], scratch=x4
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   mov x5, x0
;   ldaxp x0, x1, [x5] ; trap: heap_oob
;   stxp w4, x0, x1, [x5] ; trap: heap_oob
;   cbnz x4, #4
;   ret

function %atomic_load_i128_scratch(i64) -> i128 {
    ss0 = explicit_slot 16, align = 16
block0(v0: i64):
    v1 = uextend.i128 v0
    v2 = stack_addr.i64 ss0
    store.i128 little v1, v2
    v3 = atomic_load.i128 little v2
    return v3
}

