function %umin_i8_imm(i8) -> i8 {
block0(v0: i8):
    v1 = iconst.i8 100
    v2 = umin v0, v1
    return v2
}

; VCode:
; block0:
;   movz w4, #100
;   uxtb w3, w0
;   subs wzr, w3, #100
;   csel x0, x0, x4, lo
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   mov w4, #0x64
;   uxtb w3, w0
;   cmp w3, #0x64
;   csel x0, x0, x4, lo
;   ret

function %umin_i32(i32, i32) -> i32 {
block0(v0: i32, v1: i32):
    v2 = umin v0, v1
    return v2
}

