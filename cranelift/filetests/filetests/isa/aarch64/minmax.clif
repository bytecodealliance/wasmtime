test compile precise-output
set opt_level=speed
target aarch64

function %umin_i8(i8, i8) -> i8 {
block0(v0: i8, v1: i8):
    v2 = umin v0, v1
    return v2
}

; VCode:
; block0:
;   uxtb w3, w0
;   subs wzr, w3, w1, UXTB
;   csel x0, x0, x1, lo
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   uxtb w3, w0
;   cmp w3, w1, uxtb
;   csel x0, x0, x1, lo
;   ret

function %smin_i8(i8, i8) -> i8 {
block0(v0: i8, v1: i8):
    v2 = smin v0, v1
    return v2
}

; VCode:
; block0:
;   sxtb w3, w0
;   subs wzr, w3, w1, SXTB
;   csel x0, x0, x1, lt
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   sxtb w3, w0
;   cmp w3, w1, sxtb
;   csel x0, x0, x1, lt
;   ret

