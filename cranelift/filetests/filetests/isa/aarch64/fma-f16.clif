test compile precise-output
set unwind_info=false
target aarch64

function %f0(f16, f16, f16) -> f16 {
block0(v0: f16, v1: f16, v2: f16):
    v3 = fma v0, v1, v2
    return v3
}

; VCode:
; block0:
;   fmadd h0, h0, h1, h2
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   fmadd h0, h0, h1, h2
;   ret
