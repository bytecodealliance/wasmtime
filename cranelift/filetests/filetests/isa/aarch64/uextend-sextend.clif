test compile precise-output
set unwind_info=false
target aarch64

function %f_u_8_64(i8) -> i64 {
block0(v0: i8):
  v1 = uextend.i64 v0
  return v1
}

; VCode:
; block0:
;   uxtb w0, w0
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   uxtb w0, w0
;   ret

