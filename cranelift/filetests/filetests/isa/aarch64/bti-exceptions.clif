test compile precise-output
target aarch64 use_bti

function %try_call(i32) -> i32 {
    sig0 = (i32) -> i32 tail
    fn0 = %g(i32) -> i32 tail

    block0(v0: i32):
        try_call fn0(v0), sig0, block1, [ default: block2(exn0) ]

    block1:
        return v0

    block2(v1: i64):
        v2 = ireduce.i32 v1
        return v2
}

