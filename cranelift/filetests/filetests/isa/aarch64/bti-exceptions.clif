function %try_call_indirect(i32) -> i32 {
    sig0 = (i32) -> i32 tail
    fn0 = %g(i32) -> i32 tail

    block0(v0: i32):
        v1 = func_addr.i64 fn0
        try_call_indirect v1(v0), sig0, block1, [ default: block2(exn0) ]

    block1:
        return v0

    block2(v2: i64):
        v3 = ireduce.i32 v2
        return v3
}

