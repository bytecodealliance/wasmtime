test compile precise-output
set unwind_info=false
target aarch64

;; `fmov s0, w11` is S-sized, not `fmov h0`: `mov_to_fpu` downgrades Size16 to
;; Size32 when FEAT_FP16 is off, so no half-precision instruction is used.
function %fcopysign_f16(f16, f16) -> f16 {
block0(v0: f16, v1: f16):
    v2 = fcopysign v0, v1
    return v2
}

; VCode:
; block0:
;   umov w3, v0.h[0]
;   umov w5, v1.h[0]
;   and w7, w3, #32767
;   and w9, w5, #32768
;   orr w11, w7, w9
;   fmov s0, w11
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   umov w3, v0.h[0]
;   umov w5, v1.h[0]
;   and w7, w3, #0x7fff
;   and w9, w5, #0x8000
;   orr w11, w7, w9
;   fmov s0, w11
;   ret

