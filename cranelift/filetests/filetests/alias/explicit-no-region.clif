test optimize precise-output
set opt_level=speed
target aarch64

;; Document explicit no-region: regionless store does not keep a later named
;; store from being DSE candidates across a regionless load.
function %f(i64) -> i32 {
    region0 = 0 "heap"
block0(v0: i64):
    v1 = iconst.i32 1
    store notrap region0 v1, v0
    v2 = load.i32 notrap v0
    v3 = iconst.i32 42
    store notrap region0 v3, v0
    return v2
}

