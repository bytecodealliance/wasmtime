test optimize precise-output
set opt_level=speed
target aarch64

;; The call does not write region0, so the second load is redundant.
function %redundant_load_across_call(i64) -> i64 {
    region0 = 0 "A"
    region1 = 1 "B"
    sig0 = (i64) notrap nothrow reads(all) writes(all except region0)
block0(v0: i64):
    v1 = load.i64 notrap aligned region0 v0
    call_indirect sig0, v0(v0)
    v2 = load.i64 notrap aligned region0 v0
    v3 = iadd v1, v2
    return v3
}

