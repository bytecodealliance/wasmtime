test optimize precise-output
set opt_level=speed_and_size
target x86_64

;; Regression test for https://github.com/bytecodealliance/wasmtime/issues/14131
;;
;; The first store is regionless ("other") and does not act as a fence. The
;; second `region0` store is then dead against the third. When DSE unwinds
;; last-store state, it must restore the raw previous `region0` slot and must
;; not materialize the last-fence fallback into that slot.

function %f(i64, i64) system_v {
    region0 = 1 "table"

block0(v0: i64, v1: i64):
    v2 = iconst.i32 0
    store notrap v2, v1
    store notrap region0 v2, v0
    store notrap region0 v2, v0
    fence
    return
}

