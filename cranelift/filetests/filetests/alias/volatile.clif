;     v1 = iconst.i32 1
;     store notrap aligned v1, v0  ; v1 = 1
;     v2 = iconst.i32 2
;     store notrap aligned volatile v2, v0  ; v2 = 2
;     v3 = load.i32 notrap aligned v0
;     return v3
; }

;; Nothing known about memory is forwarded across a volatile access.
function %no_forwarding_across_volatile(i64, i64) -> i32 {
block0(v0: i64, v1: i64):
    v2 = iconst.i32 1
    store notrap aligned v2, v0
    v3 = load.i32 notrap aligned volatile v1
    v4 = load.i32 notrap aligned v0
    v5 = iadd v3, v4
    return v5
}

; function %no_forwarding_across_volatile(i64, i64) -> i32 fast {
; block0(v0: i64, v1: i64):
;     v2 = iconst.i32 1
;     store notrap aligned v2, v0  ; v2 = 1
;     v3 = load.i32 notrap aligned volatile v1
;     v4 = load.i32 notrap aligned v0
;     v5 = iadd v3, v4
;     return v5
; }

;; A plain store before a volatile access is observed by it and stays, even
;; when a later plain store overwrites it.
function %plain_store_observed_by_volatile(i64, i64) {
block0(v0: i64, v1: i64):
    v2 = iconst.i32 1
    v3 = iconst.i32 2
    store notrap aligned v2, v0
    v4 = load.i32 notrap aligned volatile v1
    store notrap aligned v3, v0
    return
}

