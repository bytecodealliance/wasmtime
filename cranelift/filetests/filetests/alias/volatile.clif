test optimize precise-output
set opt_level=speed
target x86_64

;; Volatile accesses happen exactly as written. `notrap` would let every access
;; below be removed or merged; `volatile` must keep each one.

;; Two volatile stores to the same location: the first is not a dead store.
function %volatile_store_twice(i64) {
block0(v0: i64):
    v1 = iconst.i32 1
    v2 = iconst.i32 2
    store notrap aligned volatile v1, v0
    store notrap aligned volatile v2, v0
    return
}

; function %volatile_store_twice(i64) fast {
; block0(v0: i64):
;     v1 = iconst.i32 1
;     store notrap aligned volatile v1, v0  ; v1 = 1
;     v2 = iconst.i32 2
;     store notrap aligned volatile v2, v0  ; v2 = 2
;     return
; }

;; Two volatile loads of the same location: the second is not redundant.
function %volatile_load_twice(i64) -> i32 {
block0(v0: i64):
    v1 = load.i32 notrap aligned volatile v0
    v2 = load.i32 notrap aligned volatile v0
    v3 = iadd v1, v2
    return v3
}

; function %volatile_load_twice(i64) -> i32 fast {
; block0(v0: i64):
;     v1 = load.i32 notrap aligned volatile v0
;     v2 = load.i32 notrap aligned volatile v0
;     v3 = iadd v1, v2
;     return v3
; }

;; A volatile load after a volatile store of the same location: no forwarding.
function %volatile_store_then_load(i64) -> i32 {
block0(v0: i64):
    v1 = iconst.i32 7
    store notrap aligned volatile v1, v0
    v2 = load.i32 notrap aligned volatile v0
    return v2
}

; function %volatile_store_then_load(i64) -> i32 fast {
; block0(v0: i64):
;     v1 = iconst.i32 7
;     store notrap aligned volatile v1, v0  ; v1 = 7
;     v2 = load.i32 notrap aligned volatile v0
;     return v2
; }

;; Storing back what a volatile load read is not an idempotent store.
function %volatile_idempotent_store(i64) {
block0(v0: i64):
    v1 = load.i32 notrap aligned volatile v0
    store notrap aligned volatile v1, v0
    return
}

; function %volatile_idempotent_store(i64) fast {
; block0(v0: i64):
;     v1 = load.i32 notrap aligned volatile v0
;     store notrap aligned volatile v1, v0
;     return
; }

;; Storing the same value twice with volatile stores keeps both.
function %volatile_same_value_twice(i64, i32) {
block0(v0: i64, v1: i32):
    store notrap aligned volatile v1, v0
    store notrap aligned volatile v1, v0
    return
}

; function %volatile_same_value_twice(i64, i32) fast {
; block0(v0: i64, v1: i32):
;     store notrap aligned volatile v1, v0
;     store notrap aligned volatile v1, v0
;     return
; }

;; A volatile load whose value is unused is still performed.
function %volatile_load_unused(i64) {
block0(v0: i64):
    v1 = load.i32 notrap aligned volatile v0
    return
}

; function %volatile_load_unused(i64) fast {
; block0(v0: i64):
;     v1 = load.i32 notrap aligned volatile v0
;     return
; }

;; A plain store is not dead when a volatile store overwrites it, and a plain
;; load after a volatile store is not forwarded from it.
function %plain_around_volatile(i64) -> i32 {
block0(v0: i64):
    v1 = iconst.i32 1
    v2 = iconst.i32 2
    store notrap aligned v1, v0
    store notrap aligned volatile v2, v0
    v3 = load.i32 notrap aligned v0
    return v3
}

; function %plain_around_volatile(i64) -> i32 fast {
