; block0(v0: i64, v1: i64):
;     v2 = iconst.i32 1
;     store notrap aligned v2, v0  ; v2 = 1
;     v4 = load.i32 notrap aligned volatile v1
;     v3 = iconst.i32 2
;     store notrap aligned v3, v0  ; v3 = 2
;     return
; }

;; Volatile accesses in alias regions behave the same.
function %volatile_in_region(i64) -> i32 {
    region0 = 0 "mmio"
block0(v0: i64):
    v1 = iconst.i32 1
    store notrap aligned volatile region0 v1, v0
    store notrap aligned volatile region0 v1, v0
    v2 = load.i32 notrap aligned volatile region0 v0
    v3 = load.i32 notrap aligned volatile region0 v0
    v4 = iadd v2, v3
    return v4
}

