;; Narrow, wide and vector volatile accesses, and extending loads.
function %volatile_widths(i64) -> i8, i64, i128, i8x16, i32 {
block0(v0: i64):
    v1 = load.i8 notrap volatile v0
    v2 = load.i8 notrap volatile v0
    v3 = load.i64 notrap volatile v0
    v4 = load.i64 notrap volatile v0
    v5 = load.i128 notrap volatile v0
    v6 = load.i128 notrap volatile v0
    v7 = load.i8x16 notrap volatile v0
    v8 = load.i8x16 notrap volatile v0
    v9 = uload8.i32 notrap volatile v0
    v10 = uload8.i32 notrap volatile v0
    istore8 notrap volatile v9, v0
    istore8 notrap volatile v10, v0
    return v2, v4, v6, v8, v10
}

