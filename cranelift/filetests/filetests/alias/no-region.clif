test optimize precise-output
set opt_level=speed
target aarch64

;; Explicit no-region: regionless is its own disjoint bucket for loads and
;; stores. A named-region store is invisible to a regionless load, so the
;; first store is dead here.
function %f(i64, i64) -> i32 {
    region0 = 0 "R0"
block0(v0: i64, v1: i64):
    v2 = iconst.i32 0x1234
    store notrap aligned region0 v2, v0

    v3 = load.i32 notrap aligned v1

    v4 = iconst.i32 0x5678
    store notrap aligned region0 v4, v0

    return v3
}

; function %f(i64, i64) -> i32 fast {
