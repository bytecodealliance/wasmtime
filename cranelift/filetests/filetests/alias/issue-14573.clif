;
; block0(v0: i64, v1: i32, v2: i32, v3: i32):
;     store notrap aligned region0 v1, v0
;     jump block1
;
; block1:
;     brif.i32 v3, block1, block2
;
; block2:
;     store.i32 notrap aligned region0 v2, v0
;     return
; }

;; Cross-block elimination remains valid in acyclic control flow.
function %acyclic(i64, i32, i32) {
    region0 = 0 "R0"
block0(v0: i64, v1: i32, v2: i32):
    store user1 aligned region0 v1, v0
    jump block1
block1:
    store user1 aligned region0 v2, v0
    return
}

