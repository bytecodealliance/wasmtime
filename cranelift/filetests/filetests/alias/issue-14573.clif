;     brif.i32 v3, block1, block2
;
; block2:
;     brif.i32 v2, block3, block4
;
; block3:
;     jump block5
;
; block4:
;     jump block5
;
; block5:
;     store.i32 user1 aligned region0 v2, v0
;     return
; }

