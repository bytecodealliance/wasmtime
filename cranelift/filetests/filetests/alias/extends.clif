test alias-analysis
set opt_level=speed
target aarch64

;; Test that access widths are properly accounted for when deciding
;; whether loads and stores alias.

function %f0(i64 vmctx, i32) -> i32, i8, i64, i64, i64 {
    gv0 = vmctx
    gv1 = load.i64 notrap readonly aligned gv0+8

block0(v0: i64, v1: i32):
    v2 = load.i64 notrap readonly aligned v0+8

    ;; Initial load. This will not be reused by anything below, even
    ;; though it does access the same address.
    v3 = load.i32 v2+8

    ;; These loads must remain (must not be removed as redundant), as
    ;; they access different widths at the same address.
    v4 = load.i8 v2+8
    ; check: v4 = load.i8 v2+8
    v5 = load.i64 v2+8
    ; check: v5 = load.i64 v2+8

    ;; An 8-bit store only partially overwrites the address.
    v6 = ireduce.i8 v5
    store v6, v2+8

    ;; This must not pick up the store data.
    v7 = load.i64 v2+8
    ; check: v7 = load.i64 v2+8

    ;; Another 8-bit store, this one of an unrelated value.
    v8 = iconst.i8 123
    store.i8 v8, v2+8

    v9 = load.i64 v2+8
    ; check: v9 = load.i64 v2+8

    return v3, v4, v5, v7, v9
}
