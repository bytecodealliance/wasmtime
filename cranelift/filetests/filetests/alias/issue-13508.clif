test interpret
test run
test alias-analysis

set opt_level=speed

target aarch64

;; Explicit no-region: a regionless store writes only the "other" bucket, so it
;; does not clobber named-region load forwarding. (Mixing regionless and named
;; tags on the same concrete address is a frontend invariant violation; the
;; runtest below uses disjoint slots.)
function %f(i64, i64, i64) -> i32, i32, i32 {
    region0 = 2 "vmctx"

block0(v0: i64, v1: i64, v2: i64):
    v3 = iconst.i64 -1
    store notrap v3, v0

    v4 = atomic_cas v2, v0, v0

    v5 = load.i32 region0 v0
    ; check: v5 = load.i32 region0 v0

    v6 = load.i32 region0 v0
    ; check: v6 -> v5

    ;; Regionless store to a different pointer: does not invalidate region0.
    v7 = iconst.i32 42
    store notrap v7, v1

    v8 = load.i32 region0 v0
    ; check: v8 -> v5

    return v5, v6, v8
}

function %g() -> i32, i32, i32 {
    ss0 = explicit_slot 8
    ss1 = explicit_slot 8
    fn0 = %f(i64, i64, i64) -> i32, i32, i32

block0:
    v0 = stack_addr.i64 ss0
    v1 = stack_addr.i64 ss1
    v2, v3, v4 = call fn0(v0, v1, v1)
    return v2, v3, v4
}

; run: %g() == [-1, -1, -1]
