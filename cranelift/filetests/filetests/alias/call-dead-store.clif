;; The call can throw, which observes region0, so the first store is kept.
function %call_can_throw(i64, i64, i64) {
    region0 = 0 "A"
    region1 = 1 "B"
    sig0 = (i64) notrap reads(region1) writes(none)
block0(v0: i64, v1: i64, v2: i64):
    store notrap aligned region0 v1, v0
    call_indirect sig0, v0(v0)
    store notrap aligned region0 v2, v0
    return
}

