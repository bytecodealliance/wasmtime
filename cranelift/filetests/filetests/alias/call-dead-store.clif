;; The call reads region0, so the first store is kept.
function %call_reads_region(i64, i64, i64) {
    region0 = 0 "A"
    sig0 = (i64) notrap nothrow reads(region0) writes(none)
block0(v0: i64, v1: i64, v2: i64):
    store notrap aligned region0 v1, v0
    call_indirect sig0, v0(v0)
    store notrap aligned region0 v2, v0
    return
}

