;; Same thing, but instructions distributed cross the chain differently.
function %chain2(i64) {
    region0 = 0 "flags"

block0(v0: i64):
    v1 = load.i32 notrap aligned region0 v0
    jump block1

block1:
    trapz v1, user26
    jump block2

block2:
    v2 = iconst.i32 0
    store notrap aligned region0 v2, v0
    jump block3

block3:
    store notrap aligned region0 v1, v0
    jump block4

block4:
    v3 = load.i32 notrap aligned region0 v0
    trapz v3, user26

    return
}

