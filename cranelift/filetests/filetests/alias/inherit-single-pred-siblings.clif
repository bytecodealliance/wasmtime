test optimize precise-output
set opt_level=speed
target x86_64

;; A parent's exit state must stay live across *all* of its dominator-tree
;; children, so that every sibling can inherit the parent's end-of-block state.

function %siblings(i64, i64, i32) -> i32, i32, i32, i32 {
    region0 = 0 "flags"
    region1 = 1 "R1"

block0(v0: i64, v1: i64, v2: i32):
    v3 = load.i32 notrap aligned region0 v0
    v4 = load.i32 notrap aligned region1 v1

    ;; Dead store.
    v5 = iconst.i32 0
    store notrap aligned region0 v5, v0

    ;; Idempotent store.
    store notrap aligned region0 v3, v0

    brif v2, block1, block4

;; The first child of `block0`, whose sole predecessor is `block0`. Should
;; inherit `block0`'s exit state.
block1:
    ;; Clobber `region0`.
    v6 = iconst.i32 1
    store notrap aligned region0 v6, v0
    jump block2

block2:
    ;; Redundant; should be replaced with `v4`.
    v7 = load.i32 notrap aligned region1 v1
    jump block3

block3:
    ;; Forwards to (a rematerialized) `v6` from the store in `block1`, not to
    ;; the load of `v3`.
    v8 = load.i32 notrap aligned region0 v0

    return v3, v4, v7, v8

;; The second child of `block0`, whose sole predecessor is `block0`. Sibling to
;; `block1`. Should inherit `block0`'s exit state.
block4:
    ;; Redundant; should be replaced with `v3`.
    v9 = load.i32 notrap aligned region0 v0

    ;; Redundant; should be replaced with `v4`.
    v10 = load.i32 notrap aligned region1 v1

    return v3, v4, v9, v10
}

