test optimize precise-output
set opt_level=speed
target aarch64

;; Regression test for issue #13961.

function %load_after_dead_store(i64) -> i32 {
    region0 = 0 "R0"
block0(v0: i64):
    v1 = iconst.i32 1
    store notrap region0 v1, v0
    v2 = iconst.i32 2
    store notrap region0 v2, v0
    v3 = load.i32 region0 v0
    return v3
}

; function %load_after_dead_store(i64) -> i32 fast {
;     region0 = 0 "R0"
;
; block0(v0: i64):
;     v2 = iconst.i32 2
;     store notrap region0 v2, v0  ; v2 = 2
;     return v2  ; v2 = 2
; }

function %idempotent_store_cross_block(i64) -> i32 {
    region0 = 0 "R0"
block0(v0: i64):
    v1 = load.i32 notrap region0 v0
    store notrap region0 v1, v0
    jump block1

block1:
    store notrap region0 v1, v0
    return v1
}

