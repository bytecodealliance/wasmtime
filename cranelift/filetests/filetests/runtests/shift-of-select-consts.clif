test interpret
test run
set opt_level=speed
target aarch64
target s390x
target x86_64
target riscv64
target pulley32
target pulley64

function %ishl_const_select_i32_9_1(i8) -> i32 {
block0(v0: i8):
    v1 = iconst.i32 9
    v2 = iconst.i32 1
    v3 = select v0, v1, v2
    v4 = iconst.i32 -1
    v5 = ishl v4, v3
    return v5
}
; run: %ishl_const_select_i32_9_1(0) == -2
; run: %ishl_const_select_i32_9_1(1) == -512
; run: %ishl_const_select_i32_9_1(-1) == -512

