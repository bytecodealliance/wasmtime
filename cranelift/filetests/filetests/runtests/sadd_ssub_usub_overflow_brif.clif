; run: %ssubof_brif_i16(0x8000, 1) == [0x7FFF, 1]
; run: %ssubof_brif_i16(0x7FFF, -1) == [0x8000, 1]
; run: %ssubof_brif_i16(-1, 0x7FFF) == [0x8000, 0]
; run: %ssubof_brif_i16(-1, -1) == [0, 0]
; run: %ssubof_brif_i16(0, 0x8000) == [0x8000, 1]

