; run: %ssubof_brif_i32(1, 0) == [1, 0]
; run: %ssubof_brif_i32(0x80000000, 1) == [0x7FFFFFFF, 1]
; run: %ssubof_brif_i32(0x7FFFFFFF, -1) == [0x80000000, 1]
; run: %ssubof_brif_i32(-1, 0x7FFFFFFF) == [0x80000000, 0]
; run: %ssubof_brif_i32(-1, -1) == [0, 0]
; run: %ssubof_brif_i32(0, 0x80000000) == [0x80000000, 1]

