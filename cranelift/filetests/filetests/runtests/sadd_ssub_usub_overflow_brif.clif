; run: %ssubof_brif_i8(1, 0) == [1, 0]
; run: %ssubof_brif_i8(0x80, 1) == [0x7F, 1]
; run: %ssubof_brif_i8(0x7F, -1) == [0x80, 1]
; run: %ssubof_brif_i8(-1, 0x7F) == [0x80, 0]
; run: %ssubof_brif_i8(-1, -1) == [0, 0]
; run: %ssubof_brif_i8(0, 0x80) == [0x80, 1]

function %usubof_brif_and_materialized_i64(i64, i64) -> i8, i8 {
block0(v0: i64, v1: i64):
  v2, v3 = usub_overflow v0, v1
  brif v3, block1, block2

block1:
  v4 = iconst.i8 1
  return v3, v4

block2:
  v5 = iconst.i8 0
  return v3, v5
}

; run: %usubof_brif_and_materialized_i64(1, 0) == [0, 0]
; run: %usubof_brif_and_materialized_i64(0, 1) == [1, 1]
; run: %usubof_brif_and_materialized_i64(0x80000000_00000000, 0x7FFFFFFF_FFFFFFFF) == [0, 0]

function %saddof_brif_and_materialized_i64(i64, i64) -> i8, i8 {
block0(v0: i64, v1: i64):
  v2, v3 = sadd_overflow v0, v1
  brif v3, block1, block2

block1:
  v4 = iconst.i8 1
  return v3, v4

block2:
  v5 = iconst.i8 0
  return v3, v5
}

; run: %saddof_brif_and_materialized_i64(0, 1) == [0, 0]
; run: %saddof_brif_and_materialized_i64(0x7FFFFFFF_FFFFFFFF, 1) == [1, 1]
; run: %saddof_brif_and_materialized_i64(0x80000000_00000000, -1) == [1, 1]

function %ssubof_brif_and_materialized_i64(i64, i64) -> i8, i8 {
block0(v0: i64, v1: i64):
  v2, v3 = ssub_overflow v0, v1
  brif v3, block1, block2

block1:
  v4 = iconst.i8 1
  return v3, v4

block2:
  v5 = iconst.i8 0
  return v3, v5
}

; run: %ssubof_brif_and_materialized_i64(1, 0) == [0, 0]
; run: %ssubof_brif_and_materialized_i64(0x80000000_00000000, 1) == [1, 1]
; run: %ssubof_brif_and_materialized_i64(0x7FFFFFFF_FFFFFFFF, -1) == [1, 1]
