; run: %ssubof_brif_i64(1, 0) == [1, 0]
; run: %ssubof_brif_i64(0x80000000_00000000, 1) == [0x7FFFFFFF_FFFFFFFF, 1]
; run: %ssubof_brif_i64(0x7FFFFFFF_FFFFFFFF, -1) == [0x80000000_00000000, 1]
; run: %ssubof_brif_i64(-1, 0x7FFFFFFF_FFFFFFFF) == [0x80000000_00000000, 0]
; run: %ssubof_brif_i64(-1, -1) == [0, 0]
; run: %ssubof_brif_i64(0, 0x80000000_00000000) == [0x80000000_00000000, 1]

