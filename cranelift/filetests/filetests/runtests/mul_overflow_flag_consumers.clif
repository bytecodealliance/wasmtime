; run: %umulof_flags_select_i16(-1, -1) == 1
; run: %umulof_flags_select_i16(-1, 2) == 1
; run: %umulof_flags_select_i16(0x7FFF, 0x7FFF) == 1
; run: %umulof_flags_select_i16(0x8000, 0x7FFF) == 1

