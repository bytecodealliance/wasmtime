function %smulof_flags_select_i8(i8, i8) -> i8 {
block0(v0: i8, v1: i8):
  v2, v3 = smul_overflow v0, v1
  v4 = iconst.i8 1
  v5 = iconst.i8 0
  v6 = select v3, v4, v5
  return v6
