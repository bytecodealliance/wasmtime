test interpret
test run
set opt_level=speed
target aarch64
target s390x
target x86_64
target riscv64
target pulley32
target pulley64

function %bor_band_i32_400_800(i32) -> i32 {
block0(v0: i32):
    v1 = iconst.i32 1024
    v2 = bor v0, v1
    v3 = iconst.i32 2048
    v4 = band v2, v3
    return v4
}
