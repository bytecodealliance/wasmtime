function %rounding_eq_add0_eq0_shift29_mask8(i32, i32) -> i8 {
block0(v0: i32, v1: i32):
    v2 = iconst.i32 29
    v3 = ushr v1, v2
    v4 = iadd v0, v3
    v5 = iconst.i32 -8
    v6 = band v4, v5
    v7 = icmp eq v0, v6
    return v7
}
