test interpret
test run
set enable_multi_ret_implicit_sret
target x86_64
target x86_64 sse41
target x86_64 sse42
target x86_64 sse42 has_avx

set opt_level=speed
target x86_64
target x86_64 sse41
target x86_64 sse42
target x86_64 sse42 has_avx

; Both instructions interpret their input lanes as signed i64 (#4734).
function %snarrow_i64x2(i64x2, i64x2) -> i32x4 {
block0(v0: i64x2, v1: i64x2):
    v2 = snarrow v0, v1
    return v2
}
; run: %snarrow_i64x2([-2147483649 -2147483648], [-2147483647 2147483646]) == [-2147483648 -2147483648 -2147483647 2147483646]
; run: %snarrow_i64x2([2147483647 2147483648], [-9223372036854775808 9223372036854775807]) == [2147483647 2147483647 -2147483648 2147483647]
; run: %snarrow_i64x2([0x00000000ffffffff 0xffffffff00000000], [0x0000000080000000 0xffffffff7fffffff]) == [2147483647 -2147483648 2147483647 -2147483648]
; run: %snarrow_i64x2([1 -2], [3 -4]) == [1 -2 3 -4]

function %unarrow_i64x2(i64x2, i64x2) -> i32x4 {
block0(v0: i64x2, v1: i64x2):
    v2 = unarrow v0, v1
    return v2
}
; run: %unarrow_i64x2([-1 0], [1 4294967294]) == [0 0 1 4294967294]
; run: %unarrow_i64x2([4294967295 4294967296], [-9223372036854775808 9223372036854775807]) == [4294967295 4294967295 0 4294967295]
; run: %unarrow_i64x2([0x00000000ffffffff 0xffffffff00000000], [0x0000000080000000 0xffffffff7fffffff]) == [4294967295 0 2147483648 0]
; run: %unarrow_i64x2([-4294967295 -4294967297], [8589934591 -1]) == [0 0 4294967295 0]
; run: %unarrow_i64x2([1 2], [3 4]) == [1 2 3 4]

function %snarrow_i64x2_same(i64x2) -> i32x4 {
block0(v0: i64x2):
    v1 = snarrow v0, v0
    return v1
}
; run: %snarrow_i64x2_same([-2147483649 2147483648]) == [-2147483648 2147483647 -2147483648 2147483647]
; run: %snarrow_i64x2_same([-17 42]) == [-17 42 -17 42]

function %unarrow_i64x2_same(i64x2) -> i32x4 {
block0(v0: i64x2):
    v1 = unarrow v0, v0
    return v1
}
; run: %unarrow_i64x2_same([-1 4294967296]) == [0 4294967295 0 4294967295]
; run: %unarrow_i64x2_same([-17 42]) == [0 42 0 42]

; Keep loaded inputs live across both operations to catch destructive aliasing.
function %narrow_loaded_live(i64x2, i64x2) -> i32x4, i32x4, i64x2, i64x2 {
    ss0 = explicit_slot 32, align=16
block0(v0: i64x2, v1: i64x2):
    v2 = stack_addr.i64 ss0
    store v0, v2
    store v1, v2+16
    v3 = load.i64x2 v2
    v4 = load.i64x2 v2+16
    v5 = snarrow v3, v4
    v6 = unarrow v3, v4
    return v5, v6, v3, v4
}
; run: %narrow_loaded_live([0xffffffff00000000 0x00000000ffffffff], [-17 42]) == [[-2147483648 2147483647 -17 42], [0 4294967295 0 42], [0xffffffff00000000 0x00000000ffffffff], [-17 42]]
; run: %narrow_loaded_live([1 -2], [3 -4]) == [[1 -2 3 -4], [1 0 3 0], [1 -2], [3 -4]]
