test interpret
test run
set opt_level=speed
target aarch64
target s390x
target x86_64
target riscv64
target pulley32
target pulley64

function %clz_eq_1_i8(i8) -> i8 {
block0(v0: i8):
    v1 = clz v0
    v2 = iconst.i8 1
    v3 = icmp eq v1, v2
    return v3
}
