function %band_eq_i32_fffffff0_0(i32) -> i8 {
block0(v0: i32):
    v1 = iconst.i32 -16
    v2 = band v0, v1
    v3 = iconst.i32 0
    v4 = icmp eq v2, v3
    return v4
}
