; run: %iadd_brif_i32(0xFFFFFFFF, 0x00000001) == [0x00000000, 0]
; run: %iadd_brif_i32(0x80000000, 0x80000000) == [0x00000000, 0]
; run: %iadd_brif_i32(0x7FFFFFFF, 0x00000001) == [0x80000000, 1]

