test interpret
test run
target x86_64

;; `brif` on an `iadd`/`isub`/`bor`/`bxor` result uses the op's own flags. The
;; wrap-to-zero cases catch flags taken from an op wider than the type.

function %iadd_brif_i8(i8, i8) -> i8, i8 {
block0(v0: i8, v1: i8):
  v2 = iadd v0, v1
  brif v2, block1, block2

block1:
  v3 = iconst.i8 1
  return v2, v3

block2:
  v4 = iconst.i8 0
  return v2, v4
}

; run: %iadd_brif_i8(0xFF, 0x01) == [0x00, 0]
; run: %iadd_brif_i8(0x80, 0x80) == [0x00, 0]
; run: %iadd_brif_i8(0x7F, 0x01) == [0x80, 1]

function %iadd_brif_i16(i16, i16) -> i16, i8 {
block0(v0: i16, v1: i16):
  v2 = iadd v0, v1
  brif v2, block1, block2

block1:
  v3 = iconst.i8 1
  return v2, v3

block2:
  v4 = iconst.i8 0
  return v2, v4
}

; run: %iadd_brif_i16(0xFFFF, 0x0001) == [0x0000, 0]
; run: %iadd_brif_i16(0x8000, 0x8000) == [0x0000, 0]
; run: %iadd_brif_i16(0x7FFF, 0x0001) == [0x8000, 1]

