function %isub_loop_counter(i64) -> i64 {
block0(v0: i64):
  v1 = iconst.i64 0
  jump block1(v0, v1)

block1(v2: i64, v3: i64):
  v4 = iconst.i64 1
  v5 = isub v2, v4
  v6 = iadd v3, v2
  brif v5, block1(v5, v6), block2

block2:
  return v6
}

; run: %isub_loop_counter(100) == 5050

function %bxor_select_and_brif(i32, i32, i32, i32) -> i32 {
block0(v0: i32, v1: i32, v2: i32, v3: i32):
  v4 = bxor v0, v1
  v5 = select v4, v2, v3
  brif v4, block1(v5), block2(v5)

block1(v6: i32):
  return v6

block2(v7: i32):
  v8 = iconst.i32 1000
  v9 = iadd v7, v8
  return v9
}

; run: %bxor_select_and_brif(0x80000000, 0x80000000, 10, 20) == 1020
; run: %bxor_select_and_brif(0, 0x80000000, 10, 20) == 10

function %iadd_load_select(i32, i32) -> i32 {
  ss0 = explicit_slot 4
block0(v0: i32, v1: i32):
  v2 = stack_addr.i64 ss0
  store.i32 v1, v2
  v3 = load.i32 v2
  v4 = iadd v3, v0
  v5 = iconst.i32 10
  v6 = iconst.i32 20
  v7 = select v4, v5, v6
  return v7
}

; run: %iadd_load_select(0x80000000, 0x80000000) == 20
; run: %iadd_load_select(2, 3) == 10

function %iadd_icmp_slt_zero_brif(i32, i32) -> i8 {
block0(v0: i32, v1: i32):
  v2 = iadd v0, v1
  v3 = iconst.i32 0
  v4 = icmp slt v2, v3
  brif v4, block1, block2

block1:
  v5 = iconst.i8 1
  return v5

block2:
  v6 = iconst.i8 0
  return v6
}

; run: %iadd_icmp_slt_zero_brif(0x7FFFFFFF, 1) == 1
; run: %iadd_icmp_slt_zero_brif(0x80000000, -1) == 0
