}

; run: %iadd_brif_i64(0xFFFFFFFF_FFFFFFFF, 0x00000000_00000001) == [0x00000000_00000000, 0]
; run: %iadd_brif_i64(0x80000000_00000000, 0x80000000_00000000) == [0x00000000_00000000, 0]
; run: %iadd_brif_i64(0x7FFFFFFF_FFFFFFFF, 0x00000000_00000001) == [0x80000000_00000000, 1]

