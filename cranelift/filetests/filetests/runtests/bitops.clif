function %test_bor_band_bxor(i32, i32, i32) -> i32 fast {
block0(v0: i32, v1: i32, v2: i32):
    v3 = bxor v0, v1
    v4 = band v3, v2
    v5 = bor v4, v0
    return v5
}

; run: %test_bor_band_bxor(0, 0, 0) == 0
; run: %test_bor_band_bxor(1, 0, 0) == 1
; run: %test_bor_band_bxor(1, 1, 1) == 1
; run: %test_bor_band_bxor(2, 1, 1) == 3
; run: %test_bor_band_bxor(0xf0, 0x0f, 0xaa) == 0xfa

function %test_bor_bor_bxor(i32, i32, i32) -> i32 fast {
block0(v0: i32, v1: i32, v2: i32):
    v3 = bor v0, v1
    v4 = bxor v0, v2
    v5 = bor v3, v4
    return v5
}

