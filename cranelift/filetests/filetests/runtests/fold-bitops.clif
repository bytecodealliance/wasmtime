function %test_isub_bnot_bnot(i32, i32) -> i32 fast {
block0(v0: i32, v1: i32):
    v2 = bnot v0
    v3 = bnot v1
    v4 = isub v2, v3
    return v4
}

; run: %test_isub_bnot_bnot(0, 0) == 0
; run: %test_isub_bnot_bnot(1, 0) == -1
; run: %test_isub_bnot_bnot(0, 1) == 1

