test interpret
test run
set enable_multi_ret_implicit_sret
target aarch64
target x86_64
target x86_64 has_avx
target riscv64 has_v
target riscv64 has_v has_c has_zcb

function %saddsat_i32x4(i32x4, i32x4) -> i32x4 {
block0(v0: i32x4, v1: i32x4):
    v2 = sadd_sat v0, v1
    return v2
}
; run: %saddsat_i32x4([256 -2147483000 2147483000 2147483000], [256 -1000 1000 1000]) == [512 -2147483648 2147483647 2147483647]
; run: %saddsat_i32x4([2147483646 -2147483647 100 -100], [1 -1 200 100]) == [2147483647 -2147483648 300 0]
; run: %saddsat_i32x4([2147483647 -2147483648 -2147483648 2147483647], [2147483647 -2147483648 -1 2147483647]) == [2147483647 -2147483648 -2147483648 2147483647]

function %saddsat_i64x2(i64x2, i64x2) -> i64x2 {
block0(v0: i64x2, v1: i64x2):
    v2 = sadd_sat v0, v1
    return v2
}
; run: %saddsat_i64x2([-9223372036854775000 9223372036854775000], [-1000 1000]) == [-9223372036854775808 9223372036854775807]
; run: %saddsat_i64x2([9223372036854775806 -9223372036854775807], [1 -1]) == [9223372036854775807 -9223372036854775808]
; run: %saddsat_i64x2([123 -456], [1 -1]) == [124 -457]
; run: %saddsat_i64x2([9223372036854775807 -9223372036854775808], [1 -1]) == [9223372036854775807 -9223372036854775808]
