test interpret
test run
set opt_level=speed
target aarch64
target s390x
target x86_64
target riscv64
target pulley32
target pulley64

function %ishl_imul_i32_3_c(i32) -> i32 {
block0(v0: i32):
    v1 = iconst.i64 3
    v2 = ishl v0, v1
    v3 = iconst.i32 12
    v4 = imul v2, v3
    return v4
}
