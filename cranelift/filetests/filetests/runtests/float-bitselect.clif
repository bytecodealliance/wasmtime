; `bitselect` on scalar floats. (aarch64 and riscv64 don't support it for
; `f16` yet, so they aren't targeted here.)
test interpret
test run
target x86_64
target x86_64 has_avx
target s390x

function %bitselect_f16(i16, i16, i16) -> i16 {
block0(v0: i16, v1: i16, v2: i16):
    v3 = bitcast.f16 v0
    v4 = bitcast.f16 v1
    v5 = bitcast.f16 v2
    v6 = bitselect v3, v4, v5
    v7 = bitcast.i16 v6
    return v7
}
; run: %bitselect_f16(0xff00, 0x1234, 0xabcd) == 0x12cd
; run: %bitselect_f16(0x8000, 0x8000, 0x7fff) == 0xffff

function %bitselect_f32(i32, i32, i32) -> i32 {
block0(v0: i32, v1: i32, v2: i32):
    v3 = bitcast.f32 v0
    v4 = bitcast.f32 v1
    v5 = bitcast.f32 v2
    v6 = bitselect v3, v4, v5
    v7 = bitcast.i32 v6
    return v7
}
; run: %bitselect_f32(0xffff0000, 0x12345678, 0x9abcdef0) == 0x1234def0
; run: %bitselect_f32(0x80000000, 0x80000000, 0x7fffffff) == 0xffffffff

function %bitselect_f64(i64, i64, i64) -> i64 {
block0(v0: i64, v1: i64, v2: i64):
    v3 = bitcast.f64 v0
    v4 = bitcast.f64 v1
    v5 = bitcast.f64 v2
    v6 = bitselect v3, v4, v5
    v7 = bitcast.i64 v6
    return v7
}
; run: %bitselect_f64(0xffffffff_00000000, 0x11111111_22222222, 0x33333333_44444444) == 0x11111111_44444444
; run: %bitselect_f64(0x80000000_00000000, 0x80000000_00000000, 0x7fffffff_ffffffff) == 0xffffffff_ffffffff
