block0(v0: i64):
    v1 = iconst.i64 -1
    v2 = srem v0, v1
    v3 = iconst.i64 0
    v4 = icmp ne v2, v3
    return v4
}
; run: %minus_one_i64(0) == 0
; run: %minus_one_i64(1) == 0
; run: %minus_one_i64(-1) == 0
; run: %minus_one_i64(0x8000000000000000) == 0
; run: %minus_one_i64(0x7FFFFFFFFFFFFFFF) == 0

function %multiple_uses_i32(i32) -> i32, i8 {
block0(v0: i32):
    v1 = iconst.i32 7
    v2 = srem v0, v1
    v3 = iconst.i32 0
    v4 = icmp eq v2, v3
    return v2, v4
}
; run: %multiple_uses_i32(10) == [3, 0]
; run: %multiple_uses_i32(-10) == [-3, 0]
; run: %multiple_uses_i32(14) == [0, 1]

function %folded_divisor_i32(i32) -> i8 {
block0(v0: i32):
    v1 = iconst.i32 3
    v2 = iconst.i32 4
    v3 = iadd v1, v2
    v4 = srem v0, v3
    v5 = iconst.i32 0
    v6 = icmp eq v4, v5
    return v6
}
; run: %folded_divisor_i32(-14) == 1
; run: %folded_divisor_i32(-15) == 0

function %two_zero_tests_i32(i32) -> i8, i8 {
block0(v0: i32):
    v1 = iconst.i32 7
    v2 = srem v0, v1
    v3 = iconst.i32 0
    v4 = icmp eq v2, v3
    v5 = icmp ne v2, v3
    return v4, v5
}
; run: %two_zero_tests_i32(14) == [1, 0]
; run: %two_zero_tests_i32(-15) == [0, 1]
; run: %two_zero_tests_i32(0x80000000) == [0, 1]

function %remainder_passed_to_block(i32) -> i32, i8 {
block0(v0: i32):
    v1 = iconst.i32 7
    v2 = srem v0, v1
    v3 = iconst.i32 0
    v6 = icmp eq v2, v3
    jump block1(v2, v6)
block1(v4: i32, v5: i8):
    return v4, v5
}
; run: %remainder_passed_to_block(10) == [3, 0]
; run: %remainder_passed_to_block(-10) == [-3, 0]
; run: %remainder_passed_to_block(14) == [0, 1]

function %numeric_remainder_chain(i32) -> i32 {
block0(v0: i32):
    v1 = iconst.i32 7
    v2 = urem v0, v1
    v3 = iadd v2, v0
    v4 = urem v3, v1
    return v4
}
; run: %numeric_remainder_chain(10) == 6
; run: %numeric_remainder_chain(14) == 0
; run: %numeric_remainder_chain(0xFFFFFFFF) == 2

;; Pack the four comparisons into one result because some targets cannot
;; return four values.
function %u8_multiple_of_7(i8) -> i8 {
block0(v0: i8):
    v1 = iconst.i8 7
    v2 = urem v0, v1
    v3 = iconst.i8 0
    v4 = icmp eq v2, v3
    v5 = icmp ne v2, v3
    v6 = icmp eq v3, v2
    v7 = icmp ne v3, v2
    v14 = iconst.i8 1
    v15 = iconst.i8 2
    v16 = iconst.i8 3
    v8 = ishl v5, v14
    v9 = ishl v6, v15
    v10 = ishl v7, v16
    v11 = bor v4, v8
    v12 = bor v9, v10
    v13 = bor v11, v12
    return v13
}
; run: %u8_multiple_of_7(0) == 5
; run: %u8_multiple_of_7(7) == 5
; run: %u8_multiple_of_7(0x80) == 10
; run: %u8_multiple_of_7(0xFE) == 10
; run: %u8_multiple_of_7(0xFF) == 10

function %s8_multiple_of_7(i8) -> i8 {
block0(v0: i8):
    v1 = iconst.i8 7
    v2 = srem v0, v1
    v3 = iconst.i8 0
    v4 = icmp eq v2, v3
    v5 = icmp ne v2, v3
    v6 = icmp eq v3, v2
    v7 = icmp ne v3, v2
    v14 = iconst.i8 1
    v15 = iconst.i8 2
    v16 = iconst.i8 3
    v8 = ishl v5, v14
    v9 = ishl v6, v15
    v10 = ishl v7, v16
    v11 = bor v4, v8
    v12 = bor v9, v10
    v13 = bor v11, v12
    return v13
}
; run: %s8_multiple_of_7(0) == 5
; run: %s8_multiple_of_7(7) == 5
; run: %s8_multiple_of_7(-7) == 5
; run: %s8_multiple_of_7(0x80) == 10
; run: %s8_multiple_of_7(-1) == 10

function %s32_multiple_of_min(i32) -> i8 {
block0(v0: i32):
    v1 = iconst.i32 0x80000000
    v2 = srem v0, v1
    v3 = iconst.i32 0
    v4 = icmp eq v2, v3
    return v4
}
; run: %s32_multiple_of_min(0) == 1
; run: %s32_multiple_of_min(0x80000000) == 1
; run: %s32_multiple_of_min(1) == 0
; run: %s32_multiple_of_min(-1) == 0
; run: %s32_multiple_of_min(0x7FFFFFFF) == 0
