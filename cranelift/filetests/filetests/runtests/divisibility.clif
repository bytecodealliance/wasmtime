function %minus_one_i32(i32) -> i8 {
block0(v0: i32):
    v1 = iconst.i32 -1
    v2 = srem v0, v1
    v3 = iconst.i32 0
    v4 = icmp eq v2, v3
    return v4
}
; run: %minus_one_i32(0) == 1
; run: %minus_one_i32(1) == 1
; run: %minus_one_i32(-1) == 1
; run: %minus_one_i32(0x80000000) == 1
; run: %minus_one_i32(0x7FFFFFFF) == 1

