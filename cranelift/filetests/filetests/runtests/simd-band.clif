test interpret
test run
target aarch64
target s390x
target x86_64
target x86_64 sse42
target x86_64 sse42 has_avx
set enable_multi_ret_implicit_sret
target riscv64 has_v
target riscv64 has_v has_c has_zcb
target pulley32
target pulley32be
target pulley64
target pulley64be


set opt_level=speed
set enable_multi_ret_implicit_sret=false
target x86_64

function %band_i8x16(i8x16, i8x16) -> i8x16 {
