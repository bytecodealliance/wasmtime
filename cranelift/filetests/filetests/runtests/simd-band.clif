function %band_bnot_band_bor_to_xor_i32x4(i32x4, i32x4) -> i32x4 {
block0(v0: i32x4, v1: i32x4):
    v2 = band v0, v1
    v3 = bnot v2
    v4 = bor v0, v1
    v5 = band v3, v4
    return v5
}

; run: %band_bnot_band_bor_to_xor_i32x4([0 -1 -2147483648 1431655765], [0 -1 2147483647 0xaaaaaaaa]) == [0 0 -1 -1]
; run: %band_bnot_band_bor_to_xor_i32x4([0 1 240 -1], [-1 0 204 0]) == [-1 1 60 -1]

function %bor_bnot_band_absorb_i32x4(i32x4, i32x4) -> i32x4 {
