;     dss2 = explicit_dynamic_slot dt1
;     gv0 = dyn_scale_target_const.i64x2
;     gv1 = dyn_scale_target_const.i32x4
;     sig0 = (i32) fast
;     fn0 = %f0 sig0
;
; block0:
;     v0 = iconst.i64 99
;     v1 = splat.types::I64x2xN v0  ; v0 = 99
;     v2 = dynamic_stack_addr.i64 dss0
;     store notrap aligned v1, v2
;     v3 = dynamic_stack_addr.i64 dss1
;     store notrap aligned v1, v3
;     v4 = iconst.i32 1
;     jump block1
;
; block1:
;     v5 = splat.types::I32x4xN v4  ; v4 = 1
;     v6 = dynamic_stack_addr.i64 dss2
;     store notrap aligned v5, v6
;     jump block2
;
; block2:
;     return
; }

;; The caller has more dynamic types than dynamic stack slots.

function %f3() {
    gv0 = dyn_scale_target_const.i64x2
    gv1 = dyn_scale_target_const.i8x16
    dt0 = i64x2*gv0
    dt1 = i8x16*gv1
    dss0 = explicit_dynamic_slot dt0
    fn0 = %f0(i32)
block0:
    v0 = iconst.i64 99
    v1 = splat.dt0 v0
    v2 = dynamic_stack_addr.i64 dss0
    store.dt0 notrap aligned v1, v2
    v3 = iconst.i8 7
    v4 = splat.dt1 v3
    v5 = iconst.i32 1
    call fn0(v5)
    return
}

