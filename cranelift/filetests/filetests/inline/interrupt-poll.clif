;     jump block1(v11)
;
; block1(v4: i64):
;     v5 = stack_addr.i64 ss0+8
;     v6 = load.i64 notrap v5
;     v7 = iadd v4, v6
;     return v7
;
; block2(v8: i64):
;     return v8
; }
