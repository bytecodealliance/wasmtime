test inline precise-output
target x86_64

;; `interrupt_poll` is classified as `is_call()` (it transfers control to the
;; interpreter), but it is not an inlineable function call and it cannot raise a
;; Cranelift exception. It must not trip the inliner's "unknown call" fallback,
;; and, when inlined at a `try_call` site, it must not be treated as a call
;; whose exception table needs fixing up. Its stack map must still be preserved
;; and remapped into the caller's stack slot index space.

;; A callee with a poll and its own stack map, inlined at a normal call site
;; that also has a stack map. The two maps should be merged.
function %poll_callee(i64, i64, i64) -> i64 tail {
    ss0 = explicit_slot 8, align = 8
block0(v0: i64, v1: i64, v2: i64):
    v3 = stack_addr.i64 ss0
    store notrap v0, v3
    v4 = interrupt_poll v1, v2, user3, stack_map=[i64 @ ss0+0]
    return v4
}

; (no functions inlined into %poll_callee)

function %poll_caller(i64, i64, i64) -> i64 tail {
    ss0 = explicit_slot 16, align = 8
    fn0 = %poll_callee(i64, i64, i64) -> i64 tail
block0(v0: i64, v1: i64, v2: i64):
    v3 = stack_addr.i64 ss0+8
    store notrap v0, v3
    v4 = call fn0(v0, v1, v2), stack_map=[i64 @ ss0+8]
    v5 = stack_addr.i64 ss0+8
    v6 = load.i64 notrap v5
    v7 = iadd v4, v6
    return v7
}

; function %poll_caller(i64, i64, i64) -> i64 tail {
;     ss0 = explicit_slot 16, align = 8
;     ss1 = explicit_slot 8, align = 8
;     sig0 = (i64, i64, i64) -> i64 tail
;     fn0 = %poll_callee sig0
;
; block0(v0: i64, v1: i64, v2: i64):
;     v3 = stack_addr.i64 ss0+8
;     store notrap v0, v3
;     jump block1
;
; block1:
;     v9 = stack_addr.i64 ss1
;     store.i64 notrap v0, v9
;     v10 = interrupt_poll.i64 v1, v2, user3, stack_map=[i64 @ ss0+8, i64 @ ss1+0]
;     jump block2(v10)
;
; block2(v8: i64):
;     v4 -> v8
;     v5 = stack_addr.i64 ss0+8
;     v6 = load.i64 notrap v5
;     v7 = iadd v4, v6
;     return v7
; }

;; A non-tail caller must keep the call: inlining the poll would violate the
;; verifier's requirement that `interrupt_poll` only appears in functions using
;; the `tail` calling convention.
function %poll_systemv_caller(i64, i64, i64) -> i64 system_v {
    fn0 = %poll_callee(i64, i64, i64) -> i64 tail
block0(v0: i64, v1: i64, v2: i64):
    v3 = call fn0(v0, v1, v2)
    return v3
}

; (no functions inlined into %poll_systemv_caller)

;; A non-tail caller must also keep a `try_call` to a poll-containing callee.
function %poll_try_systemv_caller(i64, i64, i64) -> i64 system_v {
    sig0 = (i64, i64, i64) -> i64 tail
    fn0 = %poll_callee sig0
block0(v0: i64, v1: i64, v2: i64):
    try_call fn0(v0, v1, v2), sig0, block1(ret0), [default: block2(exn0)]
block1(v3: i64):
    return v3
block2(v4: i64):
    return v4
}

; (no functions inlined into %poll_try_systemv_caller)

;; A callee with both a poll and a real call, inlined at a `try_call` site: the
;; real call has to be rewritten to a `try_call`, but the poll must be left
;; alone.
function %poll_callee_try(i64, i64, i64) -> i64 tail {
    ss0 = explicit_slot 8, align = 8
    sig0 = (i64) -> i64 tail
    fn0 = %foo sig0
block0(v0: i64, v1: i64, v2: i64):
    v3 = stack_addr.i64 ss0
    store notrap v0, v3
    v4 = interrupt_poll v1, v2, user3, stack_map=[i64 @ ss0+0]
    v5 = call fn0(v4)
    return v5
}

; (no functions inlined into %poll_callee_try)

function %poll_try_caller(i64, i64, i64) -> i64 tail {
    ss0 = explicit_slot 16, align = 8
    sig0 = (i64, i64, i64) -> i64 tail
    fn0 = %poll_callee_try(i64, i64, i64) -> i64 tail
block0(v0: i64, v1: i64, v2: i64):
    v3 = stack_addr.i64 ss0+8
    store notrap v0, v3
    try_call fn0(v0, v1, v2), sig0, block1(ret0), [default: block2(exn0)], stack_map=[i64 @ ss0+8]
block1(v4: i64):
    v5 = stack_addr.i64 ss0+8
    v6 = load.i64 notrap v5
    v7 = iadd v4, v6
    return v7
block2(v8: i64):
    return v8
}

; function %poll_try_caller(i64, i64, i64) -> i64 tail {
;     ss0 = explicit_slot 16, align = 8
;     ss1 = explicit_slot 8, align = 8
;     sig0 = (i64, i64, i64) -> i64 tail
;     sig1 = (i64, i64, i64) -> i64 tail
;     sig2 = (i64) -> i64 tail
;     fn0 = %poll_callee_try sig1
;     fn1 = %foo sig2
