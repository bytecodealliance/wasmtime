;;! flags = "-O signals-based-traps=n -W max-wasm-stack=4096 -W async-stack-size=131072"

;; Tests that a stack overflow is reported as a trap, with signals-based traps
;; disabled, when the function's frame is bigger than the entire native stack:
;; the check must happen before any of that frame is allocated or written to.

(module
  (type $many (func (result
    i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64
    i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64
    i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64
    i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64
    i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64)))

  (func $one (result i64) (i64.const 1))

  ;; Returns 100 ones.
  (func $many (type $many)
    (call $one) (call $one) (call $one) (call $one) (call $one) (call $one) (call $one) (call $one)
    (call $one) (call $one) (call $one) (call $one) (call $one) (call $one) (call $one) (call $one)
