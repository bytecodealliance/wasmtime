;; Even a non-recursive call overflows the tiny stack: this is the first wasm
;; frame on the stack, directly called from the host.
(assert_exhaustion (invoke "big" (i32.const 0)) "call stack exhausted")

;; The instance is still usable afterwards.
(assert_return (invoke "ok") (i64.const 1))
