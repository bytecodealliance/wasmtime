;;! flags = "-O signals-based-traps=n -W max-wasm-stack=4096"

;; Tests that a stack overflow is reported as a trap, with signals-based traps
;; disabled, when the function's frame is much bigger than the whole wasm stack:
;; the check must happen before any of that frame is allocated or written to.
;;
;; Keeps 4096 `i64` values, which can't be rematerialized, live on the
;; wasm stack across a (maybe) recursive call, so that `$big`'s frame is at
;; least 32 KiB.

(module
  (func $one (result i64) (i64.const 1))
  (func $big (export "big") (param $depth i32) (result i64)
    (call $one) (call $one) (call $one) (call $one) (call $one) (call $one) (call $one) (call $one)
    (call $one) (call $one) (call $one) (call $one) (call $one) (call $one) (call $one) (call $one)
    (call $one) (call $one) (call $one) (call $one) (call $one) (call $one) (call $one) (call $one)
    (call $one) (call $one) (call $one) (call $one) (call $one) (call $one) (call $one) (call $one)
    (call $one) (call $one) (call $one) (call $one) (call $one) (call $one) (call $one) (call $one)
