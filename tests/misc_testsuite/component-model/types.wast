(component
  (type (instance
    (export "x" (instance $x
      (type $t u32)
      (export "y" (type (eq $t)))
    ))
    (alias export $x "y" (type $t))
    (export "my-y" (type (eq $t)))
  ))

  (type (component
    (import "x" (instance $x
      (type $t u32)
      (export "y" (type (eq $t)))
    ))
    (alias export $x "y" (type $t))
    (export "my-y" (type (eq $t)))
  ))
)

(component
  (type $t u32)
  (export $t2 "t" (type $t))
  (type $r (record (field "x" $t2)))
  (export "r" (type $r))
)

(component
  (component
    (import "x" (instance $i
      (type $i u32)
      (export "i" (type (eq $i)))
    ))
    (alias export $i "i" (type $i))
    (export "i" (type $i))
  )
)

(component
  (type $u u32)
  (instance $i
    (export "i" (type $u))
  )
  (alias export $i "i" (type $i))
  (export "i" (type $i))
)

(component
  (component $c
    (type $t u32)
    (export "t" (type $t))
  )
  (instance $c (instantiate $c))
  (export "i" (type $c "t"))
)

(component
  (component $c
    (import "x" (component $c
      (type $t u32)
      (export "t" (type (eq $t)))
    ))
    (instance $c (instantiate $c))
    (export "i" (type $c "t"))
  )

  (component $x
    (type $t u32)
    (export "t" (type $t))
  )

  (instance $c (instantiate $c (with "x" (component $x))))
)

(component
  (type $t1 u64)
  (import "a" (type $t2 (eq $t1)))
  (import "b" (type $t3 (eq $t2)))
)

(component
  (import "a" (instance
    (type $t1 u64)
    (export "a" (type $t2 (eq $t1)))
    (export "b" (type (eq $t2)))
  ))
)

(component
  (type (export "x") (component
    (type $t' (instance
      (export "r" (type (sub resource)))
    ))
    (export "t" (instance $t (type $t')))
  ))
)

(component
  (type (export "x") (instance
    (type $t' (instance
      (export "r" (type (sub resource)))
    ))
    (export "t" (instance $t (type $t')))
  ))
)

(component definition $A
  (type $t' (variant (case "a" u32) (case "b")))
  (export $t "t" (type $t'))

  (core module $m
    (memory (export "m") 1)
    (func (export "f") (param i32) (result i32)
      (i32.store8
        (i32.const 0)
        (local.get 0))
      i32.const 0)
  )
  (core instance $m (instantiate $m))
  (func (export "f") (param "a" u32) (result $t)
    (canon lift (core func $m "f") (memory (core memory $m "m")))
  )
)

(component instance $A $A)
(assert_return (invoke "f" (u32.const 0)) (variant.const "a" (u32.const 0)))
(assert_return (invoke "f" (u32.const 1)) (variant.const "b"))
(assert_trap (invoke "f" (u32.const 2)) "discriminant 2 out of range [0..2)")

;; Lifting and lowering integers of all sizes.
(component definition $Ints
  (core module $m
    (func (export "take-i32-100") (param i32)
      (if (i32.ne (local.get 0) (i32.const 100)) (then unreachable)))
    (func (export "take-i64-100") (param i64)
      (if (i64.ne (local.get 0) (i64.const 100)) (then unreachable)))
    (func (export "ret-i32-0") (result i32) i32.const 0)
    (func (export "ret-i64-0") (result i64) i64.const 0)
    (func (export "ret-i32-minus-1") (result i32) i32.const -1)
    (func (export "ret-i64-minus-1") (result i64) i64.const -1)
    (func (export "ret-i32-100000") (result i32) i32.const 100000)
  )
  (core instance $i (instantiate $m))
  (func (export "take-u8") (param "a" u8) (canon lift (core func $i "take-i32-100")))
  (func (export "take-s8") (param "a" s8) (canon lift (core func $i "take-i32-100")))
  (func (export "take-u16") (param "a" u16) (canon lift (core func $i "take-i32-100")))
  (func (export "take-s16") (param "a" s16) (canon lift (core func $i "take-i32-100")))
  (func (export "take-u32") (param "a" u32) (canon lift (core func $i "take-i32-100")))
  (func (export "take-s32") (param "a" s32) (canon lift (core func $i "take-i32-100")))
  (func (export "take-u64") (param "a" u64) (canon lift (core func $i "take-i64-100")))
  (func (export "take-s64") (param "a" s64) (canon lift (core func $i "take-i64-100")))

  (func (export "ret-u8") (result u8) (canon lift (core func $i "ret-i32-0")))
  (func (export "ret-s8") (result s8) (canon lift (core func $i "ret-i32-0")))
  (func (export "ret-u16") (result u16) (canon lift (core func $i "ret-i32-0")))
  (func (export "ret-s16") (result s16) (canon lift (core func $i "ret-i32-0")))
  (func (export "ret-u32") (result u32) (canon lift (core func $i "ret-i32-0")))
  (func (export "ret-s32") (result s32) (canon lift (core func $i "ret-i32-0")))
  (func (export "ret-u64") (result u64) (canon lift (core func $i "ret-i64-0")))
  (func (export "ret-s64") (result s64) (canon lift (core func $i "ret-i64-0")))

  (func (export "retm1-u8") (result u8) (canon lift (core func $i "ret-i32-minus-1")))
  (func (export "retm1-s8") (result s8) (canon lift (core func $i "ret-i32-minus-1")))
  (func (export "retm1-u16") (result u16) (canon lift (core func $i "ret-i32-minus-1")))
  (func (export "retm1-s16") (result s16) (canon lift (core func $i "ret-i32-minus-1")))
  (func (export "retm1-u32") (result u32) (canon lift (core func $i "ret-i32-minus-1")))
  (func (export "retm1-s32") (result s32) (canon lift (core func $i "ret-i32-minus-1")))
  (func (export "retm1-u64") (result u64) (canon lift (core func $i "ret-i64-minus-1")))
  (func (export "retm1-s64") (result s64) (canon lift (core func $i "ret-i64-minus-1")))

  (func (export "retbig-u8") (result u8) (canon lift (core func $i "ret-i32-100000")))
  (func (export "retbig-s8") (result s8) (canon lift (core func $i "ret-i32-100000")))
  (func (export "retbig-u16") (result u16) (canon lift (core func $i "ret-i32-100000")))
  (func (export "retbig-s16") (result s16) (canon lift (core func $i "ret-i32-100000")))
  (func (export "retbig-u32") (result u32) (canon lift (core func $i "ret-i32-100000")))
  (func (export "retbig-s32") (result s32) (canon lift (core func $i "ret-i32-100000")))
)
(component instance $Ints $Ints)

;; Passing in 100 is valid for all primitives.
(assert_return (invoke "take-u8" (u8.const 100)))
(assert_return (invoke "take-s8" (s8.const 100)))
(assert_return (invoke "take-u16" (u16.const 100)))
(assert_return (invoke "take-s16" (s16.const 100)))
(assert_return (invoke "take-u32" (u32.const 100)))
(assert_return (invoke "take-s32" (s32.const 100)))
(assert_return (invoke "take-u64" (u64.const 100)))
(assert_return (invoke "take-s64" (s64.const 100)))

;; Zero can be returned as any integer.
(assert_return (invoke "ret-u8") (u8.const 0))
(assert_return (invoke "ret-s8") (s8.const 0))
(assert_return (invoke "ret-u16") (u16.const 0))
(assert_return (invoke "ret-s16") (s16.const 0))
(assert_return (invoke "ret-u32") (u32.const 0))
(assert_return (invoke "ret-s32") (s32.const 0))
(assert_return (invoke "ret-u64") (u64.const 0))
(assert_return (invoke "ret-s64") (s64.const 0))

;; Returning -1 reinterprets the bytes as defined by each type.
(assert_return (invoke "retm1-u8") (u8.const 0xff))
(assert_return (invoke "retm1-s8") (s8.const -1))
(assert_return (invoke "retm1-u16") (u16.const 0xffff))
(assert_return (invoke "retm1-s16") (s16.const -1))
(assert_return (invoke "retm1-u32") (u32.const 0xffffffff))
(assert_return (invoke "retm1-s32") (s32.const -1))
(assert_return (invoke "retm1-u64") (u64.const 0xffffffffffffffff))
(assert_return (invoke "retm1-s64") (s64.const -1))

;; Returning 100000 chops off bytes as necessary.
(assert_return (invoke "retbig-u8") (u8.const 0xa0))
(assert_return (invoke "retbig-s8") (s8.const -96))
(assert_return (invoke "retbig-u16") (u16.const 0x86a0))
(assert_return (invoke "retbig-s16") (s16.const -31072))
(assert_return (invoke "retbig-u32") (u32.const 100000))
(assert_return (invoke "retbig-s32") (s32.const 100000))

;; The core function traps if any value other than 100 is passed.
(component instance $Ints $Ints)
(assert_trap (invoke "take-u8" (u8.const 101)) "unreachable")
(component instance $Ints $Ints)
(assert_trap (invoke "take-s8" (s8.const 101)) "unreachable")
(component instance $Ints $Ints)
(assert_trap (invoke "take-u16" (u16.const 101)) "unreachable")
(component instance $Ints $Ints)
(assert_trap (invoke "take-s16" (s16.const 101)) "unreachable")
(component instance $Ints $Ints)
(assert_trap (invoke "take-u32" (u32.const 101)) "unreachable")
(component instance $Ints $Ints)
(assert_trap (invoke "take-s32" (s32.const 101)) "unreachable")
(component instance $Ints $Ints)
(assert_trap (invoke "take-u64" (u64.const 101)) "unreachable")
(component instance $Ints $Ints)
(assert_trap (invoke "take-s64" (s64.const 101)) "unreachable")

;; Floats, including NaN payloads, pass through unmodified.
(component
  (core module $m
    (func (export "i32.reinterpret_f32") (param f32) (result i32)
      local.get 0
      i32.reinterpret_f32)
    (func (export "i64.reinterpret_f64") (param f64) (result i64)
      local.get 0
      i64.reinterpret_f64)
    (func (export "f32.reinterpret_i32") (param i32) (result f32)
      local.get 0
      f32.reinterpret_i32)
    (func (export "f64.reinterpret_i64") (param i64) (result f64)
      local.get 0
      f64.reinterpret_i64)
  )
  (core instance $i (instantiate $m))

  (func (export "f32-to-u32") (param "a" f32) (result u32)
    (canon lift (core func $i "i32.reinterpret_f32")))
  (func (export "f64-to-u64") (param "a" f64) (result u64)
    (canon lift (core func $i "i64.reinterpret_f64")))
  (func (export "u32-to-f32") (param "a" u32) (result f32)
    (canon lift (core func $i "f32.reinterpret_i32")))
  (func (export "u64-to-f64") (param "a" u64) (result f64)
    (canon lift (core func $i "f64.reinterpret_i64")))
)

(assert_return (invoke "f32-to-u32" (f32.const 1)) (u32.const 0x3f800000))
(assert_return (invoke "f64-to-u64" (f64.const 2)) (u64.const 0x4000000000000000))
(assert_return (invoke "u32-to-f32" (u32.const 0x40400000)) (f32.const 3))
(assert_return (invoke "u64-to-f64" (u64.const 0x4010000000000000)) (f64.const 4))
(assert_return (invoke "u32-to-f32" (u32.const 0x7fc00001)) (f32.const nan:0x400001))
(assert_return (invoke "u64-to-f64" (u64.const 0x7ff8000000000001))
  (f64.const nan:0x8000000000001))
(assert_return (invoke "f32-to-u32" (f32.const nan:0x400001)) (u32.const 0x7fc00001))
(assert_return (invoke "f64-to-u64" (f64.const nan:0x8000000000001))
  (u64.const 0x7ff8000000000001))

;; Chars round-trip, and invalid code points fail to lift.
(component definition $Chars
  (core module $m
    (func (export "pass") (param i32) (result i32) local.get 0)
  )
  (core instance $i (instantiate $m))

  (func (export "u32-to-char") (param "a" u32) (result char)
    (canon lift (core func $i "pass")))
  (func (export "char-to-u32") (param "a" char) (result u32)
    (canon lift (core func $i "pass")))
)
(component instance $Chars $Chars)

(assert_return (invoke "char-to-u32" (char.const "x")) (u32.const 0x78))
(assert_return (invoke "u32-to-char" (u32.const 0x78)) (char.const "x"))
(assert_return (invoke "char-to-u32" (char.const "a")) (u32.const 0x61))
(assert_return (invoke "u32-to-char" (u32.const 0x61)) (char.const "a"))
(assert_return (invoke "char-to-u32" (char.const "\00")) (u32.const 0))
(assert_return (invoke "u32-to-char" (u32.const 0)) (char.const "\00"))
(assert_return (invoke "char-to-u32" (char.const "\n")) (u32.const 0x0a))
(assert_return (invoke "u32-to-char" (u32.const 0x0a)) (char.const "\n"))
(assert_return (invoke "char-to-u32" (char.const "💝")) (u32.const 0x1f49d))
(assert_return (invoke "u32-to-char" (u32.const 0x1f49d)) (char.const "💝"))

(component instance $Chars $Chars)
(assert_trap (invoke "u32-to-char" (u32.const 0xd800)) "integer out of range")
(component instance $Chars $Chars)
(assert_trap (invoke "u32-to-char" (u32.const 0xdfff)) "integer out of range")
(component instance $Chars $Chars)
(assert_trap (invoke "u32-to-char" (u32.const 0x110000)) "integer out of range")
(component instance $Chars $Chars)
(assert_trap (invoke "u32-to-char" (u32.const 0xffffffff)) "integer out of range")

;; A tuple returned through a return pointer.
(component definition $TupleResult
  (core module $m
    (memory (export "memory") 1)
    (func (export "foo") (param i32 i32 f32 f64) (result i32)
      (local $base i32)
      (local.set $base (i32.const 8))
      (i32.store8 offset=0 (local.get $base) (local.get 0))
      (i32.store16 offset=2 (local.get $base) (local.get 1))
      (f32.store offset=4 (local.get $base) (local.get 2))
      (f64.store offset=8 (local.get $base) (local.get 3))
      local.get $base)
    (func (export "invalid") (result i32)
      i32.const -8)
  )
  (core instance $i (instantiate $m))

  (type $result (tuple s8 u16 f32 f64))
  (func (export "tuple")
    (param "a" s8) (param "b" u16) (param "c" f32) (param "d" f64) (result $result)
    (canon lift (core func $i "foo") (memory (core memory $i "memory"))))
  (func (export "invalid") (result $result)
    (canon lift (core func $i "invalid") (memory (core memory $i "memory"))))
)
(component instance $TupleResult $TupleResult)
(assert_return
  (invoke "tuple" (s8.const -1) (u16.const 100) (f32.const 3) (f64.const 100))
  (tuple.const (s8.const -1) (u16.const 100) (f32.const 3) (f64.const 100)))
(assert_trap (invoke "invalid") "pointer out of bounds of memory")

;; Tuples passed as flattened parameters and results.
(component
  (core module $m
    (func (export "foo") (param i32 f64 i32) (result i32)
      (if (i32.ne (local.get 0) (i32.const 0)) (then unreachable))
      (if (f64.ne (local.get 1) (f64.const 1)) (then unreachable))
      (if (i32.ne (local.get 2) (i32.const 2)) (then unreachable))
      i32.const 3)
  )
  (core instance $i (instantiate $m))

  (func (export "foo")
    (param "a" (tuple s32 f64))
    (param "b" (tuple s8))
    (result (tuple u16))
    (canon lift (core func $i "foo")))
)
(assert_return
  (invoke "foo"
    (tuple.const (s32.const 0) (f64.const 1))
    (tuple.const (s8.const 2)))
  (tuple.const (u16.const 3)))

;; A `(tuple bool char)` lifted from memory.
(component definition $CharBool
  (core module $m
    (memory (export "memory") 1)
    (func (export "ret-tuple") (param i32 i32) (result i32)
      (i32.store offset=0 (i32.const 8) (local.get 0))
      (i32.store offset=4 (i32.const 8) (local.get 1))
      i32.const 8)
  )
  (core instance $i (instantiate $m))

  (func (export "ret-tuple") (param "a" u32) (param "b" u32) (result (tuple bool char))
    (canon lift (core func $i "ret-tuple") (memory (core memory $i "memory"))))
)
(component instance $CharBool $CharBool)
(assert_return (invoke "ret-tuple" (u32.const 0) (u32.const 0x61))
  (tuple.const (bool.const false) (char.const "a")))
(assert_return (invoke "ret-tuple" (u32.const 1) (u32.const 0x1f370))
  (tuple.const (bool.const true) (char.const "🍰")))
(assert_return (invoke "ret-tuple" (u32.const 2) (u32.const 0x61))
  (tuple.const (bool.const true) (char.const "a")))
(assert_trap (invoke "ret-tuple" (u32.const 0) (u32.const 0xd800)) "integer out of range")

;; Lifting and lowering options.
(component definition $Option
  (core module $m
    (memory (export "memory") 1)
    (global $last (mut i32) (i32.const 8))
    (func $realloc (export "realloc") (param i32 i32 i32 i32) (result i32)
      (local $ret i32)
      (local.set $ret
        (i32.and
          (i32.add (global.get $last) (i32.sub (local.get 2) (i32.const 1)))
          (i32.sub (i32.const 0) (local.get 2))))
      (global.set $last (i32.add (local.get $ret) (local.get 3)))
      (local.get $ret))
    (func (export "pass1") (param i32 i32) (result i32)
      (local $base i32)
      (local.set $base (call $realloc (i32.const 0) (i32.const 0) (i32.const 4) (i32.const 8)))
      (i32.store offset=0 (local.get $base) (local.get 0))
      (i32.store offset=4 (local.get $base) (local.get 1))
      (local.get $base))
    (func (export "pass2") (param i32 i32 i32) (result i32)
      (local $base i32)
      (local.set $base (call $realloc (i32.const 0) (i32.const 0) (i32.const 4) (i32.const 12)))
      (i32.store offset=0 (local.get $base) (local.get 0))
      (i32.store offset=4 (local.get $base) (local.get 1))
      (i32.store offset=8 (local.get $base) (local.get 2))
      (local.get $base))
  )
  (core instance $i (instantiate $m))

  (func (export "option-u8-to-tuple") (param "a" (option u8)) (result (tuple u32 u32))
    (canon lift (core func $i "pass1") (memory (core memory $i "memory"))))
  (func (export "option-u32-to-tuple") (param "a" (option u32)) (result (tuple u32 u32))
    (canon lift (core func $i "pass1") (memory (core memory $i "memory"))))
  (func (export "option-string-to-tuple") (param "a" (option string)) (result (tuple u32 string))
    (canon lift (core func $i "pass2") (memory (core memory $i "memory"))
      (realloc (core func $i "realloc"))))
  (func (export "to-option-u8") (param "a" u32) (param "b" u32) (result (option u8))
    (canon lift (core func $i "pass1") (memory (core memory $i "memory"))))
  (func (export "to-option-u32") (param "a" u32) (param "b" u32) (result (option u32))
    (canon lift (core func $i "pass1") (memory (core memory $i "memory"))))
  (func (export "to-option-string") (param "a" u32) (param "b" string) (result (option string))
    (canon lift (core func $i "pass2") (memory (core memory $i "memory"))
      (realloc (core func $i "realloc"))))
)
(component instance $Option $Option)
(assert_return (invoke "option-u8-to-tuple" (option.none))
  (tuple.const (u32.const 0) (u32.const 0)))
(assert_return (invoke "option-u8-to-tuple" (option.some (u8.const 0)))
  (tuple.const (u32.const 1) (u32.const 0)))
(assert_return (invoke "option-u8-to-tuple" (option.some (u8.const 100)))
  (tuple.const (u32.const 1) (u32.const 100)))
(assert_return (invoke "option-u32-to-tuple" (option.none))
  (tuple.const (u32.const 0) (u32.const 0)))
(assert_return (invoke "option-u32-to-tuple" (option.some (u32.const 0)))
  (tuple.const (u32.const 1) (u32.const 0)))
(assert_return (invoke "option-u32-to-tuple" (option.some (u32.const 100)))
  (tuple.const (u32.const 1) (u32.const 100)))
(assert_return (invoke "option-string-to-tuple" (option.none))
  (tuple.const (u32.const 0) (str.const "")))
(assert_return (invoke "option-string-to-tuple" (option.some (str.const "")))
  (tuple.const (u32.const 1) (str.const "")))
(assert_return (invoke "option-string-to-tuple" (option.some (str.const "hello")))
  (tuple.const (u32.const 1) (str.const "hello")))
(assert_return (invoke "to-option-u8" (u32.const 0x0000) (u32.const 0)) (option.none))
(assert_return (invoke "to-option-u8" (u32.const 0x0001) (u32.const 0))
  (option.some (u8.const 0)))
(assert_return (invoke "to-option-u8" (u32.const 0xfd01) (u32.const 0))
  (option.some (u8.const 0xfd)))
(assert_return (invoke "to-option-u32" (u32.const 0) (u32.const 0)) (option.none))
(assert_return (invoke "to-option-u32" (u32.const 1) (u32.const 0))
  (option.some (u32.const 0)))
(assert_return (invoke "to-option-u32" (u32.const 1) (u32.const 0x1234fead))
  (option.some (u32.const 0x1234fead)))
(assert_return (invoke "to-option-string" (u32.const 0) (str.const "")) (option.none))
(assert_return (invoke "to-option-string" (u32.const 1) (str.const ""))
  (option.some (str.const "")))
(assert_return (invoke "to-option-string" (u32.const 1) (str.const "cheesecake"))
  (option.some (str.const "cheesecake")))
(assert_trap (invoke "to-option-u8" (u32.const 0x0002) (u32.const 0))
  "discriminant 2 out of range")
(component instance $Option $Option)
(assert_trap (invoke "to-option-u32" (u32.const 2) (u32.const 0))
  "discriminant 2 out of range")
(component instance $Option $Option)
(assert_trap (invoke "to-option-string" (u32.const 2) (str.const ""))
  "discriminant 2 out of range")

;; Lifting and lowering results.
(component definition $Result
  (core module $m
    (memory (export "memory") 1)
    (global $last (mut i32) (i32.const 8))
    (func $realloc (export "realloc") (param i32 i32 i32 i32) (result i32)
      (local $ret i32)
      (local.set $ret
        (i32.and
          (i32.add (global.get $last) (i32.sub (local.get 2) (i32.const 1)))
          (i32.sub (i32.const 0) (local.get 2))))
      (global.set $last (i32.add (local.get $ret) (local.get 3)))
      (local.get $ret))
    (func (export "pass0") (param i32) (result i32)
      local.get 0)
    (func (export "pass1") (param i32 i32) (result i32)
      (local $base i32)
      (local.set $base (call $realloc (i32.const 0) (i32.const 0) (i32.const 4) (i32.const 8)))
      (i32.store offset=0 (local.get $base) (local.get 0))
      (i32.store offset=4 (local.get $base) (local.get 1))
      (local.get $base))
    (func (export "pass2") (param i32 i32 i32) (result i32)
      (local $base i32)
      (local.set $base (call $realloc (i32.const 0) (i32.const 0) (i32.const 4) (i32.const 12)))
      (i32.store offset=0 (local.get $base) (local.get 0))
      (i32.store offset=4 (local.get $base) (local.get 1))
      (i32.store offset=8 (local.get $base) (local.get 2))
      (local.get $base))
  )
  (core instance $i (instantiate $m))

  (func (export "take-result-unit") (param "a" (result)) (result u32)
    (canon lift (core func $i "pass0")))
  (func (export "take-result-u8-f32") (param "a" (result u8 (error f32))) (result (tuple u32 u32))
    (canon lift (core func $i "pass1") (memory (core memory $i "memory"))))
  (type $list (list u8))
  (func (export "take-result-string") (param "a" (result string (error $list))) (result (tuple u32 string))
    (canon lift (core func $i "pass2") (memory (core memory $i "memory"))
      (realloc (core func $i "realloc"))))
  (func (export "to-result-unit") (param "a" u32) (result (result))
    (canon lift (core func $i "pass0")))
  (func (export "to-result-s16-f32") (param "a" u32) (param "b" u32) (result (result s16 (error f32)))
    (canon lift (core func $i "pass1") (memory (core memory $i "memory"))
      (realloc (core func $i "realloc"))))
)
(component instance $Result $Result)
(assert_return (invoke "take-result-unit" (result.ok)) (u32.const 0))
(assert_return (invoke "take-result-unit" (result.err)) (u32.const 1))
(assert_return (invoke "take-result-u8-f32" (result.ok (u8.const 1)))
  (tuple.const (u32.const 0) (u32.const 1)))
(assert_return (invoke "take-result-u8-f32" (result.err (f32.const 2)))
  (tuple.const (u32.const 1) (u32.const 0x40000000)))
(assert_return (invoke "take-result-string" (result.ok (str.const "hello")))
  (tuple.const (u32.const 0) (str.const "hello")))
(assert_return
  (invoke "take-result-string"
    (result.err (list.const
      (u8.const 0x67) (u8.const 0x6f) (u8.const 0x6f) (u8.const 0x64)
      (u8.const 0x62) (u8.const 0x79) (u8.const 0x65))))
  (tuple.const (u32.const 1) (str.const "goodbye")))
(assert_return (invoke "to-result-unit" (u32.const 0)) (result.ok))
(assert_return (invoke "to-result-unit" (u32.const 1)) (result.err))
(assert_return (invoke "to-result-s16-f32" (u32.const 0) (u32.const 0))
  (result.ok (s16.const 0)))
(assert_return (invoke "to-result-s16-f32" (u32.const 0) (u32.const 100))
  (result.ok (s16.const 100)))
(assert_return (invoke "to-result-s16-f32" (u32.const 1) (u32.const 0x3f800000))
  (result.err (f32.const 1)))
(assert_return (invoke "to-result-s16-f32" (u32.const 1) (u32.const 0x7fc00001))
  (result.err (f32.const nan:0x400001)))
(assert_trap (invoke "to-result-unit" (u32.const 2)) "discriminant 2 out of range")
(component instance $Result $Result)
(assert_trap (invoke "to-result-s16-f32" (u32.const 2) (u32.const 0))
  "discriminant 2 out of range")

;; A list of options and results, checked for its in-memory layout.
(component
  (core module $m
    (memory (export "memory") 1)
    (global $last (mut i32) (i32.const 8))
    (func $realloc (export "realloc") (param i32 i32 i32 i32) (result i32)
      (local $ret i32)
      (local.set $ret
        (i32.and
          (i32.add (global.get $last) (i32.sub (local.get 2) (i32.const 1)))
          (i32.sub (i32.const 0) (local.get 2))))
      (global.set $last (i32.add (local.get $ret) (local.get 3)))
      (local.get $ret))

    ;; Each element is 16 bytes: the option discriminant at 0, its payload at
    ;; 1, the result discriminant at 4, and the error string's pointer and
    ;; length at 8 and 12.
    (func (export "take") (param $ptr i32) (param $len i32) (result i32)
      (local $ret i32)
      (if (i32.ne (local.get $len) (i32.const 3)) (then unreachable))

      ;; (option.none) (result.ok)
      (if (i32.ne (i32.load8_u offset=0 (local.get $ptr)) (i32.const 0)) (then unreachable))
      (if (i32.ne (i32.load8_u offset=4 (local.get $ptr)) (i32.const 0)) (then unreachable))

      ;; (option.some 2) (result.err "hello there")
      (if (i32.ne (i32.load8_u offset=16 (local.get $ptr)) (i32.const 1)) (then unreachable))
      (if (i32.ne (i32.load8_u offset=17 (local.get $ptr)) (i32.const 2)) (then unreachable))
      (if (i32.ne (i32.load8_u offset=20 (local.get $ptr)) (i32.const 1)) (then unreachable))
      (if (i32.ne (i32.load offset=28 (local.get $ptr)) (i32.const 11)) (then unreachable))
      (if (i32.ne (i32.load8_u (i32.load offset=24 (local.get $ptr))) (i32.const 0x68))
        (then unreachable))

      ;; (option.some 200) (result.err "general kenobi")
      (if (i32.ne (i32.load8_u offset=32 (local.get $ptr)) (i32.const 1)) (then unreachable))
      (if (i32.ne (i32.load8_u offset=33 (local.get $ptr)) (i32.const 200)) (then unreachable))
      (if (i32.ne (i32.load8_u offset=36 (local.get $ptr)) (i32.const 1)) (then unreachable))
      (if (i32.ne (i32.load offset=44 (local.get $ptr)) (i32.const 14)) (then unreachable))
      (if (i32.ne (i32.load8_u (i32.load offset=40 (local.get $ptr))) (i32.const 0x67))
        (then unreachable))

      ;; Return the same list back to the caller.
      (local.set $ret (call $realloc (i32.const 0) (i32.const 0) (i32.const 4) (i32.const 8)))
      (i32.store offset=0 (local.get $ret) (local.get $ptr))
      (i32.store offset=4 (local.get $ret) (local.get $len))
      (local.get $ret))
  )
  (core instance $i (instantiate $m))

  (type $a (option u8))
  (type $b (result (error string)))
  (type $input (list (tuple $a $b)))
  (func (export "take") (param "a" $input) (result $input)
    (canon lift (core func $i "take") (memory (core memory $i "memory"))
      (realloc (core func $i "realloc"))))
)
(assert_return
  (invoke "take" (list.const
    (tuple.const (option.none) (result.ok))
    (tuple.const (option.some (u8.const 2)) (result.err (str.const "hello there")))
    (tuple.const (option.some (u8.const 200)) (result.err (str.const "general kenobi")))))
  (list.const
    (tuple.const (option.none) (result.ok))
    (tuple.const (option.some (u8.const 2)) (result.err (str.const "hello there")))
    (tuple.const (option.some (u8.const 200)) (result.err (str.const "general kenobi")))))
