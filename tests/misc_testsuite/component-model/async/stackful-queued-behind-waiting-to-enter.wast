  (instance $a (instantiate $A))
  (instance $c (instantiate $C (with "a" (func $a "a")) (with "b" (func $a "b")) (with "c" (func $a "c"))))
  (export "run" (func $c "run")))

(assert_return (invoke "run"))

;; Same as above, but the caller cancels $A.c while it's queued, before it has
;; started. It must be removed without running (it traps if it does) and
;; without leaking its place in line: once everything else has returned, a new
;; callback-lifted call ($A.e) must start and return right away instead of
;; getting in line. Stackful $A.d then wakes $A.a in $A.c's place.
(component
  (component $A
    (core func $task.return (canon task.return))
    (core func $thread.index (canon thread.index))
    (core func $thread.suspend (canon thread.suspend))
    (core func $thread.resume-later (canon thread.resume-later))
    (core module $m
      (import "" "task.return" (func $task.return))
      (import "" "thread.index" (func $thread.index (result i32)))
      (import "" "thread.suspend" (func $thread.suspend (result i32)))
      (import "" "thread.resume-later" (func $thread.resume-later (param i32)))
      (global $a-thread (mut i32) (i32.const 0))
      (func (export "a") (result i32)
        (global.set $a-thread (call $thread.index))
        (drop (call $thread.suspend))
        (call $task.return)
        (i32.const 0 (; EXIT ;)))
      (func (export "b") (result i32) (call $task.return) (i32.const 0 (; EXIT ;)))
      (func (export "c") unreachable)
      (func (export "d")
        (call $thread.resume-later (global.get $a-thread))
        (call $task.return))
      (func (export "e") (result i32) (call $task.return) (i32.const 0 (; EXIT ;)))
      (func (export "cb") (param i32 i32 i32) (result i32) unreachable))
    (core instance $i (instantiate $m (with "" (instance
      (export "task.return" (func $task.return))
      (export "thread.index" (func $thread.index))
      (export "thread.suspend" (func $thread.suspend))
      (export "thread.resume-later" (func $thread.resume-later))))))
    (func (export "a") async (canon lift (core func $i "a") async (callback (core func $i "cb"))))
    (func (export "b") async (canon lift (core func $i "b") async (callback (core func $i "cb"))))
    (func (export "c") async (canon lift (core func $i "c") async))
    (func (export "d") async (canon lift (core func $i "d") async))
    (func (export "e") async (canon lift (core func $i "e") async (callback (core func $i "cb")))))

  (component $C
    (import "a" (func $a async))
    (import "b" (func $b async))
    (import "c" (func $c async))
    (import "d" (func $d async))
    (import "e" (func $e async))
    (core module $libc (memory (export "mem") 1))
    (core instance $libc (instantiate $libc))
    (core func $a (canon lower (func $a) async (memory (core memory $libc "mem"))))
    (core func $b (canon lower (func $b) async (memory (core memory $libc "mem"))))
    (core func $c (canon lower (func $c) async (memory (core memory $libc "mem"))))
    (core func $d (canon lower (func $d) async (memory (core memory $libc "mem"))))
    (core func $e (canon lower (func $e) async (memory (core memory $libc "mem"))))
    (core func $waitable-set.new (canon waitable-set.new))
    (core func $waitable-set.wait (canon waitable-set.wait (memory (core memory $libc "mem"))))
    (core func $waitable.join (canon waitable.join))
    (core func $subtask.cancel (canon subtask.cancel))
    (core func $subtask.drop (canon subtask.drop))
    (core func $task.return (canon task.return))
    (core module $m
      (import "libc" "mem" (memory 1))
      (import "" "a" (func $a (result i32)))
      (import "" "b" (func $b (result i32)))
      (import "" "c" (func $c (result i32)))
      (import "" "d" (func $d (result i32)))
      (import "" "e" (func $e (result i32)))
      (import "" "waitable-set.new" (func $waitable-set.new (result i32)))
      (import "" "waitable-set.wait" (func $waitable-set.wait (param i32 i32) (result i32)))
      (import "" "waitable.join" (func $waitable.join (param i32 i32)))
      (import "" "subtask.cancel" (func $subtask.cancel (param i32) (result i32)))
      (import "" "subtask.drop" (func $subtask.drop (param i32)))
      (import "" "task.return" (func $task.return))
      (func (export "run")
        (local $ret i32) (local $ws i32) (local $n i32) (local $sub i32)
        (local.set $ws (call $waitable-set.new))
        ;; $A.a suspends holding the lock: STARTED (1)
        (local.set $ret (call $a))
        (if (i32.ne (i32.and (local.get $ret) (i32.const 0xf)) (i32.const 1)) (then unreachable))
        (call $waitable.join (i32.shr_u (local.get $ret) (i32.const 4)) (local.get $ws))
        ;; $A.b needs the lock: STARTING (0)
        (local.set $ret (call $b))
        (if (i32.ne (i32.and (local.get $ret) (i32.const 0xf)) (i32.const 0)) (then unreachable))
        (call $waitable.join (i32.shr_u (local.get $ret) (i32.const 4)) (local.get $ws))
        ;; $A.c: queued behind $A.b: STARTING (0); cancel it before it starts
        (local.set $ret (call $c))
        (if (i32.ne (i32.and (local.get $ret) (i32.const 0xf)) (i32.const 0)) (then unreachable))
        (local.set $sub (i32.shr_u (local.get $ret) (i32.const 4)))
        (if (i32.ne (call $subtask.cancel (local.get $sub)) (i32.const 3 (; START_CANCELLED ;)))
          (then unreachable))
        (call $subtask.drop (local.get $sub))
        ;; $A.d: queued behind $A.b: STARTING (0)
        (local.set $ret (call $d))
        (if (i32.ne (i32.and (local.get $ret) (i32.const 0xf)) (i32.const 0)) (then unreachable))
        (call $waitable.join (i32.shr_u (local.get $ret) (i32.const 4)) (local.get $ws))
        ;; wait for $A.a, $A.b and $A.d to return
        (loop $l
          (if (i32.ne (call $waitable-set.wait (local.get $ws) (i32.const 0)) (i32.const 1 (; SUBTASK ;)))
            (then unreachable))
          (if (i32.eq (i32.load (i32.const 4)) (i32.const 2 (; RETURNED ;)))
            (then
              (call $waitable.join (i32.load (i32.const 0)) (i32.const 0))
              (call $subtask.drop (i32.load (i32.const 0)))
              (local.set $n (i32.add (local.get $n) (i32.const 1)))))
          (br_if $l (i32.lt_u (local.get $n) (i32.const 3))))
        ;; nobody is in line any more, so $A.e returns right away: RETURNED (2)
        (if (i32.ne (call $e) (i32.const 2 (; RETURNED ;))) (then unreachable))
        (call $task.return)))
    (core instance $i (instantiate $m (with "libc" (instance $libc)) (with "" (instance
      (export "a" (func $a))
      (export "b" (func $b))
      (export "c" (func $c))
      (export "d" (func $d))
      (export "e" (func $e))
      (export "waitable-set.new" (func $waitable-set.new))
      (export "waitable-set.wait" (func $waitable-set.wait))
      (export "waitable.join" (func $waitable.join))
      (export "subtask.cancel" (func $subtask.cancel))
      (export "subtask.drop" (func $subtask.drop))
      (export "task.return" (func $task.return))))))
    (func (export "run") async (canon lift (core func $i "run") async)))

  (instance $a (instantiate $A))
  (instance $c (instantiate $C
    (with "a" (func $a "a")) (with "b" (func $a "b")) (with "c" (func $a "c"))
    (with "d" (func $a "d")) (with "e" (func $a "e"))))
  (export "run" (func $c "run")))

(assert_return (invoke "run"))

;; A requeued call can stop being ready again before it runs. Here $A.x is
;; queued behind backpressure, which is then released, so $A.x is waiting to
;; start when $A.y is called. $A.y gets in line and, since the lock is free, is
;; requeued. $A.x then starts first and holds the lock across `thread.yield`,
;; so when $A.y comes up it must go back to waiting without getting in line a
;; second time. Afterwards nobody is in line, so a new call to $A.y returns
;; right away.
(component
  (component $A
    (core func $backpressure.inc (canon backpressure.inc))
    (core func $backpressure.dec (canon backpressure.dec))
    (core func $task.return (canon task.return))
    (core func $thread.yield (canon thread.yield))
    (core module $m
      (import "" "backpressure.inc" (func $backpressure.inc))
      (import "" "backpressure.dec" (func $backpressure.dec))
      (import "" "task.return" (func $task.return))
      (import "" "thread.yield" (func $thread.yield (result i32)))
      (func (export "bp-on") (call $backpressure.inc))
      (func (export "bp-off") (call $backpressure.dec))
      (func (export "x") (result i32)
        (drop (call $thread.yield))
        (call $task.return)
        (i32.const 0 (; EXIT ;)))
      (func (export "y") (result i32) (call $task.return) (i32.const 0 (; EXIT ;)))
      (func (export "cb") (param i32 i32 i32) (result i32) unreachable))
    (core instance $i (instantiate $m (with "" (instance
      (export "backpressure.inc" (func $backpressure.inc))
      (export "backpressure.dec" (func $backpressure.dec))
      (export "task.return" (func $task.return))
      (export "thread.yield" (func $thread.yield))))))
    (func (export "bp-on") (canon lift (core func $i "bp-on")))
    (func (export "bp-off") (canon lift (core func $i "bp-off")))
