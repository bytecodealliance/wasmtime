    (func (export "y") async (canon lift (core func $i "y") async (callback (core func $i "cb")))))

  (component $C
    (import "bp-on" (func $bp-on))
    (import "bp-off" (func $bp-off))
    (import "x" (func $x async))
    (import "y" (func $y async))
    (core module $libc (memory (export "mem") 1))
    (core instance $libc (instantiate $libc))
    (core func $bp-on (canon lower (func $bp-on)))
    (core func $bp-off (canon lower (func $bp-off)))
    (core func $x (canon lower (func $x) async (memory (core memory $libc "mem"))))
    (core func $y (canon lower (func $y) async (memory (core memory $libc "mem"))))
    (core func $waitable-set.new (canon waitable-set.new))
    (core func $waitable-set.wait (canon waitable-set.wait (memory (core memory $libc "mem"))))
    (core func $waitable.join (canon waitable.join))
    (core func $subtask.drop (canon subtask.drop))
    (core func $task.return (canon task.return))
    (core module $m
      (import "libc" "mem" (memory 1))
      (import "" "bp-on" (func $bp-on))
      (import "" "bp-off" (func $bp-off))
      (import "" "x" (func $x (result i32)))
      (import "" "y" (func $y (result i32)))
      (import "" "waitable-set.new" (func $waitable-set.new (result i32)))
      (import "" "waitable-set.wait" (func $waitable-set.wait (param i32 i32) (result i32)))
      (import "" "waitable.join" (func $waitable.join (param i32 i32)))
      (import "" "subtask.drop" (func $subtask.drop (param i32)))
      (import "" "task.return" (func $task.return))
      (func (export "run")
        (local $ret i32) (local $ws i32) (local $n i32)
        (local.set $ws (call $waitable-set.new))
        (call $bp-on)
        ;; $A.x is held back by backpressure: STARTING (0)
        (local.set $ret (call $x))
        (if (i32.ne (i32.and (local.get $ret) (i32.const 0xf)) (i32.const 0)) (then unreachable))
        (call $waitable.join (i32.shr_u (local.get $ret) (i32.const 4)) (local.get $ws))
        ;; release it; it's now waiting to start
        (call $bp-off)
        ;; $A.y gets in line behind $A.x: STARTING (0)
        (local.set $ret (call $y))
        (if (i32.ne (i32.and (local.get $ret) (i32.const 0xf)) (i32.const 0)) (then unreachable))
        (call $waitable.join (i32.shr_u (local.get $ret) (i32.const 4)) (local.get $ws))
        ;; wait for both to return
        (loop $l
          (if (i32.ne (call $waitable-set.wait (local.get $ws) (i32.const 0)) (i32.const 1 (; SUBTASK ;)))
            (then unreachable))
          (if (i32.eq (i32.load (i32.const 4)) (i32.const 2 (; RETURNED ;)))
            (then
              (call $waitable.join (i32.load (i32.const 0)) (i32.const 0))
              (call $subtask.drop (i32.load (i32.const 0)))
              (local.set $n (i32.add (local.get $n) (i32.const 1)))))
          (br_if $l (i32.lt_u (local.get $n) (i32.const 2))))
        ;; nobody is in line any more, so $A.y returns right away: RETURNED (2)
        (if (i32.ne (call $y) (i32.const 2 (; RETURNED ;))) (then unreachable))
        (call $task.return)))
    (core instance $i (instantiate $m (with "libc" (instance $libc)) (with "" (instance
      (export "bp-on" (func $bp-on))
      (export "bp-off" (func $bp-off))
