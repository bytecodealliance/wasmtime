      (if (i32.ne (global.get $done) (i32.const 2))
        (then (return (i32.const 1 (; YIELD ;)))))
      (call $task.return (i32.add (i32.mul (global.get $ret) (i32.const 100)) (global.get $g)))
      (i32.const 0 (; EXIT ;))))
